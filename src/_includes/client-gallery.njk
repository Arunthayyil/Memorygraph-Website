    adminBar.classList.add('visible');
    adminLoginOverlay.classList.remove('open');
    const mab = document.getElementById('menuAdminTrigger');
    if(mab) mab.classList.add('active');
    const tab = document.getElementById('topbarAdminTrigger');
    if(tab) tab.classList.add('active');
    updateHiddenCount();
    buildGallery();
    renderSelection();
  }

  function exitAdminMode(){
    isAdminMode = false;
    adminToken = null;
    adminShowHiddenOnly = false;
    sessionStorage.removeItem(adminTokenKey);
    document.body.classList.remove('admin-mode');
    adminBar.classList.remove('visible');
    const mab = document.getElementById('menuAdminTrigger');
    if(mab) mab.classList.remove('active');
    const tab = document.getElementById('topbarAdminTrigger');
    if(tab) tab.classList.remove('active');
    document.getElementById('adminFilterHidden').classList.remove('active');
    buildGallery();
    renderSelection();
  }

  // Close admin login on overlay click
  adminLoginOverlay.addEventListener('click', (e) => {
    if(e.target === adminLoginOverlay) adminLoginOverlay.classList.remove('open');
  });

  // Admin login form
  document.getElementById('adminLoginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const pw = document.getElementById('adminPasswordInput').value;
    const errorEl = document.getElementById('adminLoginError');
    errorEl.classList.remove('visible');
    try {
      const res = await fetch('/api/admin/auth', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ password: pw })
      });
      const data = await res.json();
      if(data.ok && data.token){
        adminToken = data.token;
        sessionStorage.setItem(adminTokenKey, adminToken);
        document.getElementById('adminPasswordInput').value = '';
        enterAdminMode();
      } else {
        errorEl.classList.add('visible');
      }
    } catch(err){
      errorEl.textContent = 'Could not reach server. Try again.';
      errorEl.classList.add('visible');
    }
  });

  // Admin logout
  document.getElementById('adminLogout').addEventListener('click', exitAdminMode);

  // Show hidden only filter
  document.getElementById('adminFilterHidden').addEventListener('click', () => {
    adminShowHiddenOnly = !adminShowHiddenOnly;
    document.getElementById('adminFilterHidden').classList.toggle('active', adminShowHiddenOnly);
    applyFilters();
  });

  // Patch applyFilters to respect admin hidden-only filter
  const _origApplyFilters = applyFilters;
  applyFilters = function(){
    _origApplyFilters();
    if(isAdminMode && adminShowHiddenOnly){
      document.querySelectorAll('.photo-card').forEach(card => {
        if(!card.classList.contains('admin-hidden')){
          card.classList.add('hidden');
        }
      });
    }
  };

  // Keyboard shortcut: Ctrl+Shift+A
  document.addEventListener('keydown', (e) => {
    if(e.ctrlKey && e.shiftKey && e.key === 'A'){
      e.preventDefault();
      if(isAdminMode) exitAdminMode();
      else {
        adminLoginOverlay.classList.add('open');
        document.getElementById('adminPasswordInput').focus();
      }
    }
  });

  // Restore admin session from sessionStorage
  async function tryRestoreAdmin(){
    const stored = sessionStorage.getItem(adminTokenKey);
    if(!stored) return false;
    try {
      // Validate token by making a lightweight request
      const res = await fetch('/api/admin/hidden', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'Authorization': `Bearer ${stored}`},
        body: JSON.stringify({ slug: gallerySlug, imageId: '__test__', action: 'unhide' })
      });
      if(res.ok || res.status === 400){
        // Token is valid (400 means bad input but auth passed)
        adminToken = stored;
        return true;
      }
    } catch(e){}
    sessionStorage.removeItem(adminTokenKey);
    return false;
  }

  // ═══ HAMBURGER MENU ═══
  const hamburgerBtn = document.getElementById('topbarHamburger');
  const topbarMenu = document.getElementById('topbarMenu');
  if(hamburgerBtn && topbarMenu){
    hamburgerBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      topbarMenu.classList.toggle('open');
    });
    document.addEventListener('click', (e) => {
      if(!topbarMenu.contains(e.target) && e.target !== hamburgerBtn){
        topbarMenu.classList.remove('open');
      }
    });
  }

  // Lock gallery from menu
  const menuLockBtn = document.getElementById('menuLockGallery');
  if(menuLockBtn){
    menuLockBtn.addEventListener('click', () => {
      topbarMenu.classList.remove('open');
      sessionStorage.removeItem(authKey);
      screenLock.classList.remove('hidden');
      galleryApp.setAttribute('aria-hidden','true');
    });
  }

  // ═══ SELECTION PILL TOGGLE ═══
  const selectionPill = document.getElementById('selectionPill');
  const selectionSteps = document.getElementById('selectionSteps');
  const selectionStepsBackdrop = document.getElementById('selectionStepsBackdrop');
  let selectionViewActive = false;
  let stepsShownOnce = false;
  const isMobileSelectionSurface = () => window.matchMedia('(max-width: 980px)').matches;

  // Keep shortlist modal/backdrop outside transformed topbar so fixed centering works reliably on mobile.
  if(selectionSteps && selectionSteps.parentElement !== document.body){
    document.body.appendChild(selectionSteps);
  }
  if(selectionStepsBackdrop && selectionStepsBackdrop.parentElement !== document.body){
    document.body.appendChild(selectionStepsBackdrop);
  }

  function placeSelectionStepsDesktop(){
    if(isMobileSelectionSurface()) return;
    const rect = selectionPill.getBoundingClientRect();
    const width = Math.min(380, window.innerWidth - 24);
    const left = Math.max(12, Math.min(rect.right - width, window.innerWidth - width - 12));
    const top = rect.bottom + 8;
    selectionSteps.style.left = `${left}px`;
    selectionSteps.style.top = `${top}px`;
    selectionSteps.style.right = 'auto';
    selectionSteps.style.bottom = 'auto';
    selectionSteps.style.width = `${width}px`;
    selectionSteps.style.transform = 'none';
  }

  function openSelectionSteps(){
    if(isMobileSelectionSurface()){
      if(selectionStepsBackdrop) selectionStepsBackdrop.classList.add('open');
      document.body.style.overflow = 'hidden';
    } else {
      placeSelectionStepsDesktop();
    }
    selectionSteps.classList.add('open');
  }

  function closeSelectionSteps(){
    selectionSteps.classList.remove('open');
    if(selectionStepsBackdrop) selectionStepsBackdrop.classList.remove('open');
    if(isMobileSelectionSurface() && !albumDrawer.classList.contains('open') && !lightbox.classList.contains('open')){
      document.body.style.overflow = '';
    }
  }

  selectionPill.addEventListener('click', (e) => {
    e.stopPropagation();
    if(isMobileSelectionSurface()){
      if(selectionSteps.classList.contains('open')) closeSelectionSteps();
      else openSelectionSteps();
      if(topbarMenu) topbarMenu.classList.remove('open');
      return;
    }
    if(!selectionViewActive){
      // First tap: show next-steps panel (only if never shown or has selections)
      if(!stepsShownOnce && (selected.size > 0 || notSelected.size > 0)){
        openSelectionSteps();
        stepsShownOnce = true;
        return;
      }
      // Toggle to selected view
      activeFilter = 'selected';
      selectionViewActive = true;
      selectionPill.classList.add('active');
      applyFilters();
    } else {
      // Toggle back to all
      activeFilter = 'all';
      selectionViewActive = false;
      selectionPill.classList.remove('active');
      applyFilters();
    }
  });

  // Close steps panel on outside click
  document.addEventListener('click', (e) => {
    if(selectionSteps.classList.contains('open') && !selectionSteps.contains(e.target) && e.target !== selectionPill && !selectionPill.contains(e.target)){
      closeSelectionSteps();
    }
  });

  if(selectionStepsBackdrop){
    selectionStepsBackdrop.addEventListener('click', closeSelectionSteps);
  }

  window.addEventListener('resize', () => {
    if(selectionSteps.classList.contains('open') && !isMobileSelectionSurface()){
      placeSelectionStepsDesktop();
    }
  });

  // "View Selected" from steps panel (optional button)
  const stepsViewSelectedBtn = document.getElementById('stepsViewSelected');
  if(stepsViewSelectedBtn){
    stepsViewSelectedBtn.addEventListener('click', () => {
      closeSelectionSteps();
      openAlbumDrawer();
      if(!isMobileSelectionSurface()){
        activeFilter = 'selected';
        selectionViewActive = true;
        selectionPill.classList.add('active');
        applyFilters();
      }
    });
  }

  // "Share with Arun" from steps panel
  document.getElementById('stepsOpenDrawer').addEventListener('click', () => {
    closeSelectionSteps();
    openAlbumDrawer();
  });

  // ═══ ADMIN TRIGGER IN HAMBURGER MENU ═══
  const menuAdminBtn = document.getElementById('menuAdminTrigger');
  if(menuAdminBtn){
    menuAdminBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      topbarMenu.classList.remove('open');
      if(isAdminMode){
        exitAdminMode();
      } else {
        adminLoginOverlay.classList.add('open');
        document.getElementById('adminPasswordInput').focus();
      }
    });
  }

  // ═══ ADMIN TRIGGER IN TOPBAR (desktop gear icon) ═══
  const topbarAdminBtn = document.getElementById('topbarAdminTrigger');
  if(topbarAdminBtn){
    topbarAdminBtn.addEventListener('click', () => {
      if(isAdminMode){ exitAdminMode(); }
      else { adminLoginOverlay.classList.add('open'); document.getElementById('adminPasswordInput').focus(); }
    });
  }

  // Initialize: fetch hidden list, then build
  (async () => {
    await fetchHiddenImages();
    const restored = await tryRestoreAdmin();
    if(restored) enterAdminMode();
    else {
      buildGallery();
      renderSelection();
    }
    loadLikeCounts();
  })();
</script>

