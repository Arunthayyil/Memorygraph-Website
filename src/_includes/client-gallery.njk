  function createButterfly(){
    if(!butterflyLayer) return;
    const el = document.createElement('div');
    el.className = 'butterfly';
    const isGold = Math.random() > 0.5;
    const color = isGold ? 'rgba(184,150,90,.5)' : 'rgba(244,237,224,.34)';
    const startLeft = 8 + Math.random() * 84;
    const startTop = 58 + Math.random() * 28;
    const rise = 90 + Math.random() * 90;
    const driftX = (Math.random() - 0.5) * 120;
    const scale = 0.66 + Math.random() * 0.42;
    const tilt = (Math.random() - 0.5) * 18;
    const spin = (Math.random() - 0.5) * 14;

    el.style.left = `${startLeft}vw`;
    el.style.top = `${startTop}vh`;
    el.style.color = color;
    el.style.setProperty('--butterfly-rise', `${rise}px`);
    el.style.setProperty('--butterfly-drift-x', `${driftX}px`);
    el.style.setProperty('--butterfly-scale', `${scale}`);
    el.style.setProperty('--butterfly-tilt', `${tilt}deg`);
    el.style.setProperty('--butterfly-spin', `${spin}deg`);
    el.innerHTML = `
      <svg viewBox="0 0 28 20" aria-hidden="true" focusable="false">
        <path class="butterfly-wing left" fill="currentColor" d="M13 9.8c-1.7-3.1-4.8-5.6-7.6-4.9-2.4.6-3.8 3.1-3.4 5.5.4 2.5 2 4.5 4.4 5 3.2.7 5.7-1 6.6-5.6z"/>
        <path class="butterfly-wing right" fill="currentColor" d="M15 9.8c1.7-3.1 4.8-5.6 7.6-4.9 2.4.6 3.8 3.1 3.4 5.5-.4 2.5-2 4.5-4.4 5-3.2.7-5.7-1-6.6-5.6z"/>
        <rect class="butterfly-body" x="13.25" y="5.7" width="1.5" height="8.2" rx=".75" fill="currentColor"/>
        <path class="butterfly-body" d="M14 5.3c-.9-1-1.6-1.9-2-2.8m0 0c.8.1 1.4.5 2 1m0-1c.6-.5 1.2-.9 2-.9-.4.9-1.1 1.8-2 2.7" fill="none" stroke="currentColor" stroke-width=".7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    `;
    butterflyLayer.appendChild(el);
    el.style.animation = `butterflyDrift ${5.5 + Math.random() * 2.5}s ease-in forwards`;
    el.addEventListener('animationend', () => el.remove(), { once: true });
  }

  function spawnButterflyBurst(count){
    if(!butterflyEnabled) return;
    const total = Math.max(1, Math.min(8, count || 1));
    for(let i = 0; i < total; i++){
      setTimeout(() => {
        if(!butterflyLayer) return;
        if(butterflyLayer.childElementCount >= 8) return;
        createButterfly();
      }, i * 220);
    }
