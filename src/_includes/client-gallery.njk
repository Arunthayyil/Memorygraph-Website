<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta name="robots" content="noindex, nofollow"/>
<title>{{ title }} | Client Gallery | Memorygraph Wedding Studio</title>
<link rel="icon" href="/assets/logo/favicon-32.png" type="image/png" sizes="32x32"/>
<link rel="apple-touch-icon" href="/assets/logo/favicon-180.png"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'"/>
<noscript><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet"/></noscript>
<link rel="stylesheet" href="/assets/css/global.css"/>
<link rel="stylesheet" href="/assets/css/animations.css"/>
<style>
  :root{--paper:#fbf7ef;}
  button,input,textarea,select{font:inherit;}button{cursor:pointer;}

  .screen-lock{position:fixed;inset:0;z-index:500;display:flex;align-items:center;justify-content:center;padding:24px;color:var(--ivory);overflow-y:auto;}
  .screen-lock.hidden{display:none;}
  body.gallery-locked{overflow:hidden;}
  body.gallery-locked .gallery-app{display:none!important;}
  .lock-bg{position:fixed;inset:0;z-index:0;background:url('{{ (lock_image or hero_image or "/assets/stories/abhin-gayathry/03.jpg") | safe }}') center/cover no-repeat;}
  .lock-overlay{position:fixed;inset:0;z-index:1;background:linear-gradient(180deg,rgba(26,24,20,.7) 0%,rgba(26,24,20,.6) 30%,rgba(26,24,20,.6) 60%,rgba(26,24,20,.9) 100%);}
  .lock-panel{position:relative;z-index:2;width:min(480px,100%);text-align:center;padding:56px 48px;}
  .lock-logo{height:44px;width:auto;margin-bottom:48px;filter:brightness(0) invert(1) drop-shadow(0 2px 16px rgba(0,0,0,.4));opacity:.8;}
  .lock-label,.eyebrow{font-size:.52rem;letter-spacing:.42em;text-transform:uppercase;color:var(--gold-2);font-weight:400;text-shadow:0 2px 12px rgba(0,0,0,.3);}
  .lock-label::before,.lock-label::after{content:'';display:inline-block;width:20px;height:1px;background:var(--gold);opacity:.35;vertical-align:middle;margin:0 14px;}
  .lock-title{font-family:var(--serif);font-size:clamp(2.6rem,7vw,4.8rem);font-weight:300;line-height:.94;margin:24px 0 28px;text-shadow:0 4px 40px rgba(0,0,0,.35),0 1px 6px rgba(0,0,0,.2);}
  .lock-title em{font-style:italic;color:var(--gold-2);}
  .lock-copy{max-width:380px;margin:0 auto 36px;color:rgba(244,237,224,.6);font-size:.86rem;line-height:1.9;text-shadow:0 1px 8px rgba(0,0,0,.3);}
  .lock-divider{width:48px;height:1px;background:rgba(244,237,224,.15);margin:0 auto 32px;}
  .lock-form{display:flex;flex-direction:column;gap:14px;max-width:320px;margin:0 auto;}
  .lock-form input{width:100%;padding:16px 20px;background:rgba(244,237,224,.08);border:1px solid rgba(244,237,224,.14);color:var(--ivory);text-align:center;font-size:.88rem;letter-spacing:.12em;backdrop-filter:blur(12px);transition:border-color .3s,background .3s;}
  .lock-form input::placeholder{color:rgba(244,237,224,.3);letter-spacing:.08em;}
  .lock-form input:focus{outline:none;border-color:var(--gold-2);background:rgba(244,237,224,.12);}
  .lock-form .btn{width:100%;padding:16px;letter-spacing:.28em;font-size:.6rem;}
  .lock-error{display:none;margin-top:8px;color:rgba(255,180,160,.9);font-size:.72rem;letter-spacing:.04em;text-shadow:0 1px 4px rgba(0,0,0,.2);}
  .lock-error.visible{display:block;}
  .lock-hint{margin-top:24px;color:rgba(244,237,224,.35);font-size:.62rem;line-height:1.8;letter-spacing:.02em;}
  .lock-footer{position:fixed;bottom:0;left:0;right:0;z-index:2;padding:20px;text-align:center;}
  .lock-footer-text{font-size:.48rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(244,237,224,.25);}
  .lock-footer-text a{color:rgba(244,237,224,.35);text-decoration:none;transition:color .3s;}
  .lock-footer-text a:hover{color:var(--gold-2);}
  @keyframes lockFadeIn{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}
  .screen-lock .lock-panel{animation:lockFadeIn .8s cubic-bezier(.22,1,.36,1) both;animation-delay:.2s;}
  .screen-lock .lock-bg{animation:lockBgScale 1.2s cubic-bezier(.22,1,.36,1) both;}
  @keyframes lockBgScale{from{transform:scale(1.06);}to{transform:scale(1);}}

  .btn{border:0;background:var(--teal);color:var(--ivory);padding:14px 24px;font-size:.66rem;letter-spacing:.22em;text-transform:uppercase;transition:all .3s;text-decoration:none;text-align:center;border-radius:3px;}
  .btn:hover{background:var(--teal-deep);}
  .btn.gold{background:var(--gold);color:var(--teal-deep);}
  .btn.gold:hover{background:var(--gold-2);}
  .btn.ghost{background:transparent;border:1px solid var(--line);color:var(--ink);}
  .btn.ghost:hover{border-color:var(--teal);color:var(--teal);}

  .gallery-app{position:relative;z-index:2;min-height:100vh;}

  /* ── Utility Bar (appears on scroll) ── */
  .topbar{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;gap:16px;height:60px;padding:0 36px;background:rgba(244,237,224,.96);backdrop-filter:blur(20px);border-bottom:1px solid var(--line-2);transform:translateY(-100%);transition:transform .4s cubic-bezier(.22,1,.36,1);will-change:transform;}
  .topbar.visible{transform:translateY(0);}
  .topbar img{height:32px;width:auto;display:block;opacity:.6;}
  .top-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end;}
  .topbar-home{display:grid;place-items:center;width:34px;height:34px;padding:0!important;}
  .selection-pill{display:flex;align-items:center;gap:8px;padding:8px 16px;border:1px solid rgba(29,89,89,.15);color:var(--teal);font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;background:rgba(29,89,89,.03);border-radius:3px;cursor:pointer;transition:all .3s;user-select:none;}
  .selection-pill:hover{border-color:rgba(29,89,89,.3);background:rgba(29,89,89,.06);}
  .selection-pill.active{background:var(--teal);color:var(--ivory);border-color:var(--teal);}
  .selection-pill-icon{width:16px;height:16px;flex-shrink:0;opacity:.6;}
  .selection-pill.active .selection-pill-icon{opacity:1;}
  .selection-steps{display:none;position:fixed;top:72px;right:16px;width:min(380px,calc(100vw - 32px));background:var(--ivory);border:1px solid var(--line-2);box-shadow:0 16px 48px rgba(26,24,20,.14);border-radius:4px;overflow:hidden;z-index:120;text-align:left;}
  .selection-steps.open{display:block;}
  .selection-steps-backdrop{display:none;position:fixed;inset:0;background:rgba(18,16,13,.48);backdrop-filter:blur(2px);z-index:118;}
  .selection-steps-backdrop.open{display:block;}
  @media(min-width:981px){
    .selection-steps-backdrop.open{display:none;}
  }
  .selection-steps-head{padding:18px 20px 14px;border-bottom:1px solid var(--line-2);}
  .selection-steps-title{font-family:var(--serif);font-size:1.1rem;font-weight:300;color:var(--ink);margin-bottom:4px;}
  .selection-steps-sub{font-size:.72rem;color:var(--mist);line-height:1.6;}
  .selection-steps-list{padding:14px 20px 18px;display:flex;flex-direction:column;gap:10px;}
  .selection-step{display:flex;align-items:flex-start;gap:10px;font-size:.72rem;color:var(--ink-soft);line-height:1.6;}
  .selection-step-num{width:20px;height:20px;flex-shrink:0;border-radius:50%;background:var(--teal);color:var(--ivory);font-size:.5rem;font-weight:600;display:grid;place-items:center;letter-spacing:0;}
  .selection-steps-action{padding:0 20px 18px;display:flex;gap:8px;}
  .selection-steps-action .btn{flex:1;padding:10px;font-size:.52rem;letter-spacing:.18em;text-align:center;}

  /* ── Hamburger Menu (mobile only) ── */
  .topbar-admin{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--line);background:transparent;border-radius:4px;color:var(--ink-soft);cursor:pointer;transition:all .25s;flex-shrink:0;padding:0;}
  .topbar-admin:hover{border-color:var(--teal);color:var(--teal);}
  .topbar-admin.active{background:var(--teal);color:var(--ivory);border-color:var(--teal);}
  .topbar-hamburger{display:none;width:34px;height:34px;border:1px solid var(--line);background:transparent;border-radius:4px;color:var(--ink-soft);place-items:center;cursor:pointer;transition:all .25s;flex-shrink:0;}
  .topbar-hamburger:hover{border-color:var(--teal);color:var(--teal);}
  .topbar-menu{display:none;position:absolute;top:100%;right:16px;min-width:200px;background:var(--ivory);border:1px solid var(--line-2);box-shadow:0 12px 40px rgba(26,24,20,.12);border-radius:4px;overflow:hidden;z-index:110;}
  .topbar-menu.open{display:block;}
  .topbar-menu-item{display:flex;align-items:center;gap:10px;width:100%;padding:14px 18px;border:0;background:transparent;color:var(--ink-soft);font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;cursor:pointer;transition:background .2s,color .2s;text-decoration:none;text-align:left;}
  .topbar-menu-item:hover{background:var(--ivory-2);color:var(--teal);}
  .topbar-menu-item svg{flex-shrink:0;opacity:.5;}
  .topbar-menu-item+.topbar-menu-item{border-top:1px solid var(--line-2);}

  /* ── Merged Filters in Topbar (mobile, on scroll) ── */

  /* ── Download Confirm Popup ── */
  .download-confirm{position:fixed;inset:0;z-index:500;background:rgba(15,14,12,.5);display:none;align-items:center;justify-content:center;padding:24px;backdrop-filter:blur(4px);}
  .download-confirm.open{display:flex;}
  .download-confirm-panel{width:min(400px,100%);padding:36px 32px;background:var(--paper);box-shadow:0 24px 60px rgba(0,0,0,.2);text-align:center;}
  .download-confirm-icon{margin-bottom:16px;color:var(--teal);opacity:.6;}
  .download-confirm-title{font-family:var(--serif);font-size:1.5rem;font-weight:300;margin-bottom:8px;color:var(--ink);}
  .download-confirm-text{font-size:.82rem;color:var(--mist);line-height:1.7;margin-bottom:24px;}
  .download-confirm-text strong{color:var(--ink);font-weight:500;}
  .download-confirm-actions{display:flex;gap:10px;justify-content:center;}
  .download-confirm-actions .btn{min-width:120px;}

  /* ── Hero (full-bleed cinematic cover) ── */
  .hero{position:relative;min-height:94vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;overflow:hidden;padding:80px 40px 72px;}
  .hero-bg{position:absolute;inset:0;background:url('{{ (hero_image or "/assets/stories/abhin-gayathry/01.jpg") | safe }}') center/cover;z-index:0;}
  .hero-video{position:absolute;inset:0;z-index:0;width:100%;height:100%;object-fit:cover;}
  .hero-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(26,24,20,.6) 0%,rgba(26,24,20,.45) 20%,rgba(26,24,20,.4) 40%,rgba(26,24,20,.55) 65%,rgba(26,24,20,.92) 100%);z-index:1;}
  .hero-copy{position:relative;z-index:2;max-width:680px;}
  .hero-monogram{height:48px;width:auto;filter:brightness(0) invert(1) drop-shadow(0 2px 16px rgba(0,0,0,.4));opacity:.8;margin-bottom:48px;}
  .hero-label{font-size:.52rem;letter-spacing:.42em;text-transform:uppercase;color:var(--gold-2);margin-bottom:24px;font-weight:400;text-shadow:0 2px 12px rgba(0,0,0,.3);}
  .hero-label::before,.hero-label::after{content:'';display:inline-block;width:20px;height:1px;background:var(--gold);opacity:.35;vertical-align:middle;margin:0 14px;}
  .hero h1{font-family:var(--serif);font-size:clamp(3.6rem,8vw,7.2rem);font-weight:300;line-height:.94;margin:0 0 28px;color:var(--ivory);text-shadow:0 4px 40px rgba(0,0,0,.35),0 1px 6px rgba(0,0,0,.2);}
  .hero h1 em{font-style:italic;color:var(--gold-2);}
  .hero-sub{font-size:.88rem;line-height:1.9;color:rgba(244,237,224,.7);max-width:460px;margin:0 auto 36px;text-shadow:0 1px 8px rgba(0,0,0,.3);}
  .hero-meta{display:flex;align-items:center;justify-content:center;gap:20px;}
  .meta-item{display:flex;align-items:center;gap:8px;color:rgba(244,237,224,.55);font-size:.58rem;letter-spacing:.18em;text-transform:uppercase;text-shadow:0 1px 6px rgba(0,0,0,.25);}
  .meta-item svg{flex-shrink:0;color:var(--gold-2);opacity:.6;}
  .meta-value{font-family:var(--serif);font-size:1.05rem;color:rgba(244,237,224,.85);font-weight:400;letter-spacing:0;text-transform:none;}
  .meta-dot{width:3px;height:3px;border-radius:50%;background:rgba(244,237,224,.2);flex-shrink:0;}
  .hero-scroll-hint{position:absolute;bottom:32px;left:50%;transform:translateX(-50%);z-index:2;display:flex;flex-direction:column;align-items:center;gap:8px;color:rgba(244,237,224,.3);font-size:.46rem;letter-spacing:.2em;text-transform:uppercase;animation:heroFloat 2.5s ease-in-out infinite;}
  @keyframes heroFloat{0%,100%{transform:translateX(-50%) translateY(0);}50%{transform:translateX(-50%) translateY(-6px);}}
  .hero-scroll-hint svg{opacity:.4;}

  /* ── Portrait hero — split layout (desktop only) ── */
  @media(min-width:981px){
    .hero.portrait-hero{display:grid;grid-template-columns:1fr 1fr;min-height:100vh;padding:0;text-align:left;align-items:stretch;}
    .hero.portrait-hero .hero-bg{position:relative;inset:auto;grid-column:2;grid-row:1/3;background-position:center top;}
    .hero.portrait-hero .hero-overlay{position:relative;inset:auto;grid-column:1;grid-row:1/3;background:var(--ink);}
    .hero.portrait-hero .hero-copy{position:absolute;z-index:2;top:50%;left:0;width:50%;transform:translateY(-50%);padding:0 56px;max-width:none;}
    .hero.portrait-hero .hero-monogram{margin-bottom:40px;}
    .hero.portrait-hero .hero-sub{margin:0 0 36px;}
    .hero.portrait-hero .hero-meta{justify-content:flex-start;}
    .hero.portrait-hero .hero-label::before{display:none;}
    .hero.portrait-hero .hero-scroll-hint{left:56px;transform:none;align-items:flex-start;}
    @keyframes heroFloatP{0%,100%{transform:translateY(0);}50%{transform:translateY(-6px);}}
    .hero.portrait-hero .hero-scroll-hint{animation-name:heroFloatP;}
  }

  .gallery-wrap{padding:72px 56px 120px;}
  .section-head{display:flex;align-items:end;justify-content:space-between;gap:40px;margin-bottom:40px;}
  .section-title{font-family:var(--serif);font-size:clamp(2.6rem,5vw,4.8rem);font-weight:300;line-height:1.08;color:var(--ink);}
  .section-title em{font-style:italic;color:var(--teal);}
  .section-note{max-width:460px;color:var(--ink-soft);font-size:.86rem;line-height:1.8;}
  .photo-grid{position:relative;width:100%;max-width:1420px;margin:0 auto;}
  .photo-card,.quote-card{position:absolute;background:#ede5d6;overflow:hidden;border-radius:14px;transition:transform .35s ease,opacity .35s ease,box-shadow .35s ease;box-shadow:0 12px 34px rgba(26,24,20,.075);}
  .photo-card:hover{transform:translateY(-2px);box-shadow:0 18px 44px rgba(26,24,20,.11);}
  .photo-card.hidden,.quote-card.hidden{display:none!important;}
  .photo-card img{width:100%;height:100%;object-fit:cover;display:block;transition:filter .35s;}
  .photo-card:hover img{filter:saturate(1.03) contrast(1.01);}
  .quote-card{padding:42px 34px;background:var(--ink);color:var(--ivory);border-radius:14px;}
  .quote-card blockquote{font-family:var(--serif);font-size:clamp(1.45rem,2.4vw,2.25rem);font-style:italic;font-weight:300;line-height:1.32;color:var(--ivory);}
  .quote-card cite{display:block;margin-top:22px;font-style:normal;font-size:.62rem;letter-spacing:.24em;text-transform:uppercase;color:var(--gold-2);}
  .photo-overlay{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:space-between;padding:14px;background:linear-gradient(180deg,rgba(26,24,20,.44),rgba(26,24,20,0) 42%,rgba(26,24,20,.55));opacity:0;transition:opacity .25s;}
  .photo-card:hover .photo-overlay,.photo-card.selected .photo-overlay,.photo-card.not-selected .photo-overlay{opacity:1;}
  .photo-id{align-self:flex-start;color:var(--ivory);font-size:.58rem;letter-spacing:.24em;text-transform:uppercase;text-shadow:0 2px 12px rgba(0,0,0,.35);}
  .photo-controls{display:flex;gap:8px;align-self:flex-end;}
  .photo-heart-btn{position:absolute;top:12px;right:12px;z-index:3;min-width:38px;height:38px;padding:0 10px;border:1px solid rgba(244,237,224,.28);background:rgba(26,24,20,.34);border-radius:999px;color:var(--ivory);display:inline-flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;transition:transform .2s,background .2s,border-color .2s,color .2s;backdrop-filter:blur(4px);font-size:1rem;line-height:1;white-space:nowrap;}
  .photo-heart-btn:hover{background:rgba(244,237,224,.14);border-color:rgba(244,237,224,.4);transform:translateY(-1px);}
  .photo-heart-btn.active{background:rgba(220,60,60,.88);border-color:rgba(220,60,60,.95);color:#fff;}
  .photo-heart-count{font-size:.68rem;letter-spacing:.08em;line-height:1;font-variant-numeric:tabular-nums;}
  .icon-btn{width:40px;height:40px;border:1px solid rgba(244,237,224,.4);background:rgba(26,24,20,.3);border-radius:50%;color:var(--ivory);display:grid;place-items:center;transition:all .25s;text-decoration:none;backdrop-filter:blur(4px);}
  .icon-btn:hover{background:rgba(244,237,224,.9);color:var(--teal);border-color:rgba(244,237,224,.9);}
  .icon-btn.active{background:var(--gold);border-color:var(--gold);color:var(--teal-deep);}
  .photo-card.selected .select-btn{background:var(--gold);border-color:var(--gold);color:var(--teal-deep);}
  .photo-card.selected::after{content:'Selected';position:absolute;top:14px;right:14px;padding:6px 12px;background:var(--gold);color:var(--teal-deep);font-size:.52rem;letter-spacing:.2em;text-transform:uppercase;border-radius:3px;}
  .photo-card.not-selected img{filter:grayscale(.55) brightness(.82);}
  .photo-card.not-selected .reject-btn{background:rgba(158,68,54,.92);border-color:rgba(158,68,54,.92);color:var(--ivory);}
  .photo-card.not-selected::after{content:'Not selected';position:absolute;top:14px;right:14px;padding:6px 12px;background:rgba(158,68,54,.92);color:var(--ivory);font-size:.52rem;letter-spacing:.16em;text-transform:uppercase;border-radius:3px;}

  .album-drawer{position:fixed;right:0;top:0;bottom:0;z-index:220;width:min(460px,100%);background:var(--paper);box-shadow:-24px 0 60px rgba(26,24,20,.18);transform:translateX(100%);transition:transform .35s cubic-bezier(.22,1,.36,1);display:flex;flex-direction:column;}
  .album-drawer.open{transform:translateX(0);}
  .drawer-head{padding:28px 28px 22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;}
  .drawer-title{font-family:var(--serif);font-size:2rem;font-weight:300;line-height:1;}
  .drawer-close{width:38px;height:38px;border:1px solid var(--line);background:transparent;color:var(--ink);}
  .drawer-body{padding:24px 28px;overflow:auto;flex:1;}
  .selected-list{display:grid;gap:12px;}
  .selected-group{display:grid;gap:10px;}
  .selected-group+.selected-group{margin-top:18px;padding-top:18px;border-top:1px solid var(--line);}
  .selected-group-title{font-size:.58rem;letter-spacing:.22em;text-transform:uppercase;color:var(--mist);}
  .selected-item{display:grid;grid-template-columns:76px 1fr auto;gap:12px;align-items:center;padding:10px;background:var(--ivory);border:1px solid var(--line-2);}
  .selected-item.not-selected-pick{background:rgba(158,68,54,.06);border-color:rgba(158,68,54,.16);}
  .selected-item img{width:76px;height:58px;object-fit:cover;}
  .selected-item strong{font-family:var(--serif);font-size:1.1rem;font-weight:400;display:block;}
  .selected-item span{font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--mist);}
  .selected-item.not-selected-pick span{color:rgba(158,68,54,.72);}
  .mini-remove{width:32px;height:32px;border:1px solid var(--line);background:transparent;color:var(--ink);}
  .drawer-foot{padding:22px 28px;border-top:1px solid var(--line);display:grid;gap:12px;}
  .textarea-label{font-size:.6rem;letter-spacing:.22em;text-transform:uppercase;color:var(--mist);}
  .notes,.selector-name{width:100%;padding:13px 14px;border:1px solid var(--line);background:var(--ivory);color:var(--ink);line-height:1.6;}
  .notes{min-height:94px;resize:vertical;}
  .selector-name:focus,.notes:focus{outline:1px solid var(--teal);}
  .export-output{display:none;padding:14px;background:var(--ivory);border:1px solid var(--line);font-size:.78rem;line-height:1.7;color:var(--ink-soft);white-space:pre-wrap;}
  .export-output.visible{display:block;}

  .lightbox{position:fixed;inset:0;z-index:300;background:rgba(15,14,12,.96);display:none;flex-direction:column;color:var(--ivory);}
  .lightbox.open{display:flex;}
  .lightbox.open ~ .butterfly-layer{display:none;}
  .lightbox.open ~ .butterfly-layer .butterfly{display:none;}
  .lb-stage{flex:1;display:flex;align-items:center;justify-content:center;position:relative;min-height:0;overflow:hidden;}
  .lb-stage{touch-action:pan-y;}
  .lb-stage img{max-width:min(92vw,920px);max-height:100%;object-fit:contain;box-shadow:0 20px 60px rgba(0,0,0,.38);border-radius:2px;}
  .lightbox .lb-close,.lightbox .lb-prev,.lightbox .lb-next{position:absolute;border:1px solid rgba(244,237,224,.2);background:rgba(244,237,224,.05);color:var(--ivory);z-index:2;transition:background .2s,border-color .2s,color .2s;backdrop-filter:blur(8px);}
  .lightbox .lb-close:hover,.lightbox .lb-prev:hover,.lightbox .lb-next:hover{background:rgba(244,237,224,.12);border-color:rgba(244,237,224,.32);}
  .lb-close{top:18px;right:18px;width:48px;height:48px;font-size:1.5rem;border-radius:50%;}
  .lb-close:hover{background:rgba(244,237,224,.18);border-color:rgba(244,237,224,.42);}
  .lb-prev,.lb-next{top:50%;width:44px;height:44px;border-radius:50%;transform:translateY(-50%);font-size:1.6rem;}
  .lb-prev{left:16px;}.lb-next{right:16px;}
  .lb-bar{flex-shrink:0;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 24px;background:linear-gradient(180deg,rgba(26,24,20,.56),rgba(26,24,20,.8));border-top:1px solid rgba(244,237,224,.08);backdrop-filter:blur(14px);}
  .lb-bar-info{display:flex;align-items:center;gap:10px;min-width:0;flex:1;}
  .lb-bar-id{font-size:.62rem;letter-spacing:.28em;text-transform:uppercase;color:var(--gold-2);white-space:nowrap;}
  .lb-bar-id::before{content:'Photo';margin-right:10px;color:rgba(244,237,224,.5);letter-spacing:.22em;}
  .lb-bar-actions{display:flex;gap:8px;flex-shrink:0;}
  .lb-action{display:flex;align-items:center;gap:6px;padding:9px 14px;border:1px solid rgba(244,237,224,.18);background:transparent;color:var(--ivory);font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;white-space:nowrap;transition:background .2s,border-color .2s,color .2s;}
  .lb-action:hover{background:rgba(244,237,224,.1);border-color:rgba(244,237,224,.3);}
  .lb-action.active{background:var(--gold);color:var(--teal-deep);border-color:var(--gold);}
  .lb-action-heart{border-color:rgba(220,60,60,.3);color:var(--ivory);}
  .lb-action-heart:hover{background:rgba(220,60,60,.12);border-color:rgba(220,60,60,.45);color:var(--ivory);}
  .lb-action-heart.active{background:rgba(220,60,60,.92);border-color:rgba(220,60,60,.95);color:#fff;}
  .lb-action-reject{border-color:rgba(244,237,224,.16);color:rgba(244,237,224,.64);}
  .lb-action-reject:hover{background:rgba(244,237,224,.08);border-color:rgba(244,237,224,.32);color:var(--ivory);}
  .lb-action-reject.active{background:rgba(158,68,54,.92);border-color:rgba(158,68,54,.92);color:var(--ivory);}
  .lb-action-print{border-color:rgba(184,150,90,.5);color:var(--gold-2);}
  .lb-action-print:hover{background:rgba(184,150,90,.14);border-color:var(--gold);}

  .print-banner{display:flex;align-items:center;gap:20px;padding:18px 24px;margin-bottom:36px;background:linear-gradient(135deg,rgba(29,89,89,.06),rgba(184,150,90,.08));border:1px solid rgba(184,150,90,.22);position:relative;overflow:hidden;}
  .print-banner::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--gold);}
  .print-banner-icon{flex-shrink:0;width:44px;height:44px;display:grid;place-items:center;background:rgba(184,150,90,.1);border:1px solid rgba(184,150,90,.2);color:var(--gold);}
  .print-banner-text{flex:1;min-width:0;}
  .print-banner-text strong{display:block;font-family:var(--serif);font-size:1.1rem;font-weight:400;color:var(--ink);margin-bottom:2px;}
  .print-banner-text span{font-size:.76rem;color:var(--mist);letter-spacing:.02em;}
  .print-banner-cart{display:flex;align-items:center;gap:10px;flex-shrink:0;}
  .print-cart-pill{padding:8px 14px;background:var(--gold);color:var(--teal-deep);font-size:.6rem;letter-spacing:.16em;text-transform:uppercase;border:0;transition:background .2s;}
  .print-cart-pill:hover{background:var(--gold-2);}
  .print-cart-pill.empty{background:transparent;border:1px solid var(--line);color:var(--mist);}

  .print-add-btn{background:rgba(184,150,90,.15)!important;border-color:rgba(184,150,90,.4)!important;color:var(--gold-2)!important;}
  .print-add-btn:hover{background:rgba(184,150,90,.3)!important;}

  .print-overlay{position:fixed;inset:0;z-index:400;background:rgba(15,14,12,.6);display:none;align-items:center;justify-content:center;padding:24px;backdrop-filter:blur(4px);}
  .print-overlay.open{display:flex;}
  .print-panel{width:min(540px,100%);max-height:88vh;background:var(--paper);display:flex;flex-direction:column;box-shadow:0 30px 80px rgba(0,0,0,.3);}
  .print-panel-head{padding:24px 28px 20px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:flex-start;gap:16px;}
  .print-panel-title{font-family:var(--serif);font-size:1.8rem;font-weight:300;line-height:1.1;}
  .print-panel-close{width:36px;height:36px;border:1px solid var(--line);background:transparent;color:var(--ink);flex-shrink:0;}
  .print-panel-body{padding:24px 28px;overflow-y:auto;flex:1;}
  .print-cart-list{display:grid;gap:14px;margin-bottom:20px;}
  .print-cart-item{display:grid;grid-template-columns:68px 1fr auto;gap:14px;align-items:start;padding:14px;background:var(--ivory);border:1px solid var(--line-2);}
  .print-cart-item img{width:68px;height:52px;object-fit:cover;display:block;}
  .print-cart-item-info{min-width:0;}
  .print-cart-item-id{font-family:var(--serif);font-size:1rem;font-weight:400;}
  .print-cart-size-row{display:flex;gap:6px;margin-top:8px;}
  .print-size-btn{padding:6px 12px;border:1px solid var(--line);background:var(--ivory);color:var(--ink-soft);font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;transition:all .2s;}
  .print-size-btn.active{background:var(--teal);border-color:var(--teal);color:var(--ivory);}
  .print-size-btn:hover:not(.active){border-color:var(--teal);color:var(--teal);}
  .print-qty-row{display:flex;align-items:center;gap:8px;margin-top:8px;}
  .print-qty-btn{width:28px;height:28px;border:1px solid var(--line);background:var(--ivory);color:var(--ink);font-size:.9rem;display:grid;place-items:center;}
  .print-qty-val{font-size:.82rem;min-width:20px;text-align:center;}
  .print-cart-price{font-family:var(--serif);font-size:1.1rem;color:var(--teal);white-space:nowrap;}
  .print-cart-remove{width:28px;height:28px;border:1px solid var(--line);background:transparent;color:var(--mist);font-size:.7rem;margin-top:6px;}
  .print-add-more{width:100%;padding:14px;border:1px dashed var(--line);background:transparent;color:var(--mist);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;transition:border-color .2s,color .2s;margin-bottom:24px;}
  .print-add-more:hover{border-color:var(--teal);color:var(--teal);}
  .print-subtotal{padding:14px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;font-family:var(--serif);font-size:1.2rem;margin-bottom:24px;}
  .print-subtotal span{color:var(--teal);}
  .print-form-fields{display:grid;gap:12px;margin-bottom:20px;}
  .print-input{width:100%;padding:13px 14px;border:1px solid var(--line);background:var(--ivory);color:var(--ink);font-family:var(--sans);font-size:.88rem;line-height:1.5;}
  .print-input:focus{outline:1px solid var(--teal);border-color:var(--teal);}
  .print-textarea{min-height:80px;resize:vertical;}
  .print-panel-foot{padding:18px 28px;border-top:1px solid var(--line);display:grid;gap:10px;}
  .print-note{font-size:.7rem;color:var(--mist);text-align:center;line-height:1.6;}
  .print-wa-btn{display:flex;align-items:center;justify-content:center;gap:8px;}
  .print-success{display:none;text-align:center;padding:48px 24px;}
  .print-success.visible{display:block;}
  .print-success-icon{font-size:2.4rem;margin-bottom:16px;}
  .print-success h3{font-family:var(--serif);font-size:1.6rem;font-weight:300;margin-bottom:8px;}
  .print-success p{color:var(--mist);font-size:.86rem;line-height:1.7;}
  .print-empty{text-align:center;padding:32px 16px;color:var(--mist);font-size:.86rem;line-height:1.7;}

  .gallery-credit{padding:72px 56px;background:var(--ivory-2);border-top:1px solid var(--line-2);}
  .credit-inner{display:flex;align-items:center;gap:24px;max-width:600px;margin:0 auto;}
  .credit-line{flex:1;height:1px;background:var(--line);}
  .credit-link{display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;color:var(--ink-soft);transition:color .3s;}
  .credit-link:hover{color:var(--teal);}
  .credit-logo{height:28px;width:auto;opacity:.55;transition:opacity .3s;}
  .credit-link:hover .credit-logo{opacity:.85;}
  .credit-text{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap;}
  .credit-text strong{font-weight:500;color:var(--ink);}
  .credit-link:hover .credit-text strong{color:var(--teal);}
  .credit-sub{font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--mist);}
  .credit-socials{display:flex;gap:16px;margin-top:12px;justify-content:center;}
  .credit-socials a{color:var(--mist);transition:color .3s;}
  .credit-socials a:hover{color:var(--teal);}

  /* ── Authorship Line ── */
  .authorship{padding:20px 40px;text-align:center;background:var(--ivory-2);border-bottom:1px solid var(--line-2);display:flex;align-items:center;justify-content:center;gap:24px;flex-wrap:wrap;}
  .authorship-text{font-size:.54rem;letter-spacing:.3em;text-transform:uppercase;color:var(--ink-soft);font-weight:500;}
  .authorship-text a{color:var(--mist);text-decoration:none;transition:color .3s;}
  .authorship-text a:hover{color:var(--teal);}
  .authorship-dot{width:3px;height:3px;border-radius:50%;background:var(--line);flex-shrink:0;}
  .authorship-btn{display:inline-flex;align-items:center;gap:8px;padding:8px 18px;border:1px solid var(--teal);background:var(--teal);color:var(--ivory);font-size:.5rem;letter-spacing:.22em;text-transform:uppercase;text-decoration:none;border-radius:3px;transition:all .3s;white-space:nowrap;box-shadow:0 4px 12px rgba(29,89,89,.14);}
  .authorship-btn:hover{border-color:var(--teal-deep);color:var(--ivory);background:var(--teal-deep);box-shadow:0 6px 16px rgba(29,89,89,.18);}

  /* ── Chapter Index ── */
  .chapter-index{padding:72px 56px 80px;background:var(--ivory);text-align:center;}
  .chapter-index-label{font-size:.52rem;letter-spacing:.34em;text-transform:uppercase;color:var(--gold);margin-bottom:10px;font-weight:400;}
  .chapter-index-title{font-family:var(--serif);font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:300;line-height:1.2;color:var(--ink);margin-bottom:48px;}
  .chapter-index-title em{font-style:italic;color:var(--teal);}
  .chapter-grid-hint{font-size:.62rem;letter-spacing:.14em;color:var(--mist);margin-bottom:20px;font-style:italic;font-family:var(--serif);}
  .chapter-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1px;background:var(--line-2);max-width:880px;margin:0 auto;border:1px solid var(--line-2);box-shadow:0 4px 24px rgba(26,24,20,.06);}
  .chapter-card{background:var(--ivory);padding:40px 22px 30px;text-align:center;cursor:pointer;transition:all .35s;position:relative;}
  .chapter-card:hover{background:var(--teal);color:var(--ivory);}
  .chapter-card:hover .chapter-card-num{color:var(--gold-2);}
  .chapter-card:hover .chapter-card-name{color:var(--ivory);}
  .chapter-card:hover .chapter-card-count{color:rgba(244,237,224,.6);}
  .chapter-card:hover .chapter-card-rule{background:var(--gold-2);opacity:.6;}
  .chapter-card-num{font-size:.48rem;letter-spacing:.32em;text-transform:uppercase;color:var(--gold);margin-bottom:14px;font-weight:400;transition:color .35s;}
  .chapter-card-name{font-family:var(--serif);font-size:1.2rem;font-weight:300;font-style:italic;color:var(--ink);margin-bottom:10px;line-height:1.3;transition:color .35s;}
  .chapter-card-count{font-size:.5rem;letter-spacing:.24em;text-transform:uppercase;color:var(--mist);font-weight:400;transition:color .35s;}
  .chapter-card-rule{width:24px;height:1.5px;background:var(--gold);opacity:.4;margin:16px auto 0;transition:all .35s;}
  .chapter-card--cta{background:var(--ivory-2);}
  .chapter-card--cta:hover{background:var(--teal);}
  .chapter-card-icon{margin-bottom:10px;color:var(--gold);opacity:.5;transition:color .35s;}
  .chapter-card--cta:hover .chapter-card-icon{color:var(--gold-2);opacity:.8;}
  .chapter-card--cta .chapter-card-name{font-style:normal;color:var(--teal);font-weight:400;}
  .chapter-card--cta:hover .chapter-card-name{color:var(--ivory);}
  .chapter-card--cta .chapter-card-count{color:var(--ink-soft);}
  .chapter-card--cta:hover .chapter-card-count{color:rgba(244,237,224,.6);}
  .chapter-index-cta{margin-top:48px;}
  .chapter-index-note{font-size:.78rem;color:var(--ink-soft);line-height:1.8;margin-bottom:18px;font-style:italic;font-family:var(--serif);}
  .chapter-index-btn{display:inline-flex;align-items:center;gap:10px;padding:14px 32px;background:var(--teal);color:var(--ivory);font-size:.58rem;letter-spacing:.24em;text-transform:uppercase;text-decoration:none;border:0;border-radius:3px;transition:background .3s;cursor:pointer;}
  .chapter-index-btn:hover{background:var(--teal-deep);}

  /* ── Section Divider Card ── */
  .section-divider{position:absolute;width:100%;overflow:hidden;border:0;background:transparent;border-radius:0;display:flex;align-items:center;justify-content:center;}
  .section-divider-content{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;gap:0;width:100%;padding:0 20px;height:100%;}
  .section-divider-rule{flex:1;height:1px;background:var(--line);opacity:.4;}
  .section-divider-center{display:flex;flex-direction:column;align-items:center;gap:4px;padding:0 24px;flex-shrink:0;}
  .section-divider-name{font-family:var(--serif);font-size:clamp(.85rem,1.8vw,1.05rem);font-weight:400;font-style:italic;color:var(--ink-soft,#8a8578);letter-spacing:.06em;line-height:1;white-space:nowrap;}
  .section-divider-desc{font-family:var(--sans);font-size:.68rem;color:var(--ink-soft,#8a8578);opacity:.55;font-weight:300;font-style:italic;letter-spacing:.02em;}
  .section-divider-nav{display:flex;align-items:center;gap:2px;position:absolute;right:20px;top:50%;transform:translateY(-50%);}
  .section-divider-nav button{border:0;background:transparent;color:var(--ink-soft,#8a8578);opacity:.35;cursor:pointer;font-family:var(--sans);font-size:.7rem;letter-spacing:.04em;padding:4px 6px;transition:opacity .2s;}
  .section-divider-nav button:hover{opacity:.7;}

  /* ── Floating Section Jump ── */
  .section-jump{position:fixed;bottom:24px;right:24px;z-index:95;display:none;flex-direction:column;align-items:center;gap:4px;}
  .section-jump.visible{display:flex;}
  .section-jump-btn{width:40px;height:40px;border:1px solid rgba(26,24,20,.1);background:rgba(244,237,224,.95);backdrop-filter:blur(16px);border-radius:50%;color:var(--ink-soft);display:grid;place-items:center;cursor:pointer;transition:all .25s;box-shadow:0 4px 20px rgba(26,24,20,.1);}
  .section-jump-btn:hover{background:var(--teal);color:var(--ivory);border-color:var(--teal);box-shadow:0 6px 24px rgba(29,89,89,.2);}
  .section-jump-label{font-size:.44rem;letter-spacing:.16em;text-transform:uppercase;color:var(--mist);text-align:center;line-height:1;}

  /* ── Explore CTA ── */
  .cg-explore{padding:88px 56px;background:var(--ink);text-align:center;color:var(--ivory);position:relative;overflow:hidden;}
  .cg-explore::before{content:'';position:absolute;top:-60px;left:50%;transform:translateX(-50%);width:1px;height:60px;background:linear-gradient(180deg,transparent,rgba(184,150,90,.3));}
  .cg-explore-ornament{display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:28px;}
  .cg-explore-ornament span{width:28px;height:1px;background:var(--gold);opacity:.35;}
  .cg-explore-ornament svg{width:16px;height:16px;color:var(--gold);opacity:.5;}
  .cg-explore-title{font-family:var(--serif);font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:300;line-height:1.2;margin-bottom:14px;color:var(--ivory);}
  .cg-explore-title em{font-style:italic;color:var(--gold-2);}
  .cg-explore-body{font-size:.84rem;line-height:1.9;color:rgba(244,237,224,.5);max-width:440px;margin:0 auto 32px;}
  .cg-explore-btn{display:inline-flex;align-items:center;gap:10px;padding:14px 32px;border:1px solid rgba(244,237,224,.18);background:transparent;color:var(--ivory);font-size:.62rem;letter-spacing:.24em;text-transform:uppercase;text-decoration:none;transition:all .35s;border-radius:3px;}
  .cg-explore-btn:hover{background:rgba(244,237,224,.08);border-color:var(--gold);color:var(--gold-2);}

  /* ── Review Prompt ── */
  .cg-review{padding:52px 56px;background:var(--ivory-2);text-align:center;border-top:1px solid var(--line-2);}
  .cg-review-text{font-family:var(--serif);font-size:1.15rem;font-weight:300;font-style:italic;color:var(--ink-soft);margin-bottom:12px;}
  .cg-review-sub{font-size:.74rem;color:var(--mist);margin-bottom:22px;line-height:1.7;}
  .cg-review-btn{display:inline-flex;align-items:center;gap:8px;padding:11px 24px;border:1px solid var(--line);background:var(--ivory);color:var(--ink-soft);font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;text-decoration:none;transition:all .3s;border-radius:3px;}
  .cg-review-btn:hover{border-color:var(--gold);color:var(--gold);background:rgba(184,150,90,.04);}
  .cg-review-btn svg{flex-shrink:0;color:var(--gold);}

  /* ── Gallery Footer ── */
  .cg-footer{background:rgba(26,24,20,.97);padding:48px 56px 32px;}
  .cg-footer-inner{display:flex;flex-direction:column;align-items:center;gap:24px;}
  .cg-footer-logo{height:44px;width:auto;opacity:.85;filter:brightness(0) invert(1);}
  .cg-footer-links{display:flex;gap:24px;flex-wrap:wrap;justify-content:center;}
  .cg-footer-links a{color:rgba(244,237,224,.5);font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;text-decoration:none;transition:color .3s;}
  .cg-footer-links a:hover{color:var(--gold-2);}
  .cg-footer-bottom{margin-top:24px;padding-top:20px;border-top:1px solid rgba(244,237,224,.08);text-align:center;}
  .cg-footer-copy{font-size:.6rem;letter-spacing:.14em;color:rgba(244,237,224,.3);line-height:1.8;}

  @media(max-width:980px){
    .topbar{height:52px;padding:0 16px;}
    .topbar img{height:26px;}
    .topbar-home,.topbar #downloadAll,.topbar-admin{display:none!important;}
    .topbar-hamburger{display:grid;}
    .topbar .selection-pill{padding:6px 10px;font-size:.5rem;letter-spacing:.14em;}
    .selection-steps{
      position:fixed;
      left:12px;
      right:12px;
      top:50%;
      bottom:auto;
      width:auto;
      margin-top:0;
      border-radius:10px;
      box-shadow:0 22px 56px rgba(26,24,20,.24);
      z-index:260;
      transform:translateY(-50%);
    }
    .selection-steps-head{padding:16px 16px 12px;}
    .selection-steps-list{padding:12px 16px 14px;gap:9px;}
    .selection-steps-action{padding:0 16px 14px;}
    .selection-steps-action .btn{padding:12px 8px;font-size:.54rem;letter-spacing:.18em;}
    .hero{min-height:88vh;padding:60px 28px 52px;}
    .hero h1{font-size:clamp(2.8rem,11vw,4.4rem);}
    .hero-monogram{height:36px;margin-bottom:36px;}
    .hero-sub{font-size:.82rem;max-width:320px;margin-bottom:28px;}
    .hero-scroll-hint{bottom:20px;}
    .authorship{padding:18px 24px;}
    .chapter-index{padding:52px 24px 60px;}
    .chapter-grid{grid-template-columns:repeat(2,1fr);}
    .chapter-card{padding:28px 16px 22px;}
    .chapter-card-name{font-size:1rem;}
    .gallery-wrap{padding:48px 20px 90px;}
    .photo-grid{max-width:none;}
    .photo-card,.quote-card{border-radius:13px;}
    .section-head{display:block;}
    .section-note{margin-top:18px;}
    .gallery-credit{padding:48px 24px;}
    .credit-inner{gap:16px;}
    .cg-explore{padding:60px 24px;}
    .cg-review{padding:36px 24px;}
    .cg-footer{padding:36px 24px 24px;}
    .lock-panel{padding:36px 20px;}
    .lock-logo{height:36px;margin-bottom:36px;}
    .lock-copy{font-size:.82rem;}
    .lock-label::before,.lock-label::after{width:14px;margin:0 10px;}
    .print-banner{flex-wrap:wrap;padding:16px 18px;gap:14px;}
    .print-banner-icon{width:36px;height:36px;}
    .print-banner-text strong{font-size:1rem;}
    .print-banner-cart{width:100%;}
    .print-cart-pill{width:100%;text-align:center;}
    .album-drawer{
      width:100%;
      max-width:none;
      top:0;
      right:0;
      bottom:0;
      border-radius:0;
      box-shadow:none;
      transform:translateY(100%);
      border-top:1px solid var(--line);
      background:linear-gradient(180deg,var(--paper) 0%,var(--ivory) 100%);
    }
    .album-drawer.open{transform:translateY(0);}
    .drawer-head{
      position:sticky;
      top:0;
      z-index:2;
      padding:18px 16px 14px;
      background:linear-gradient(180deg,var(--paper) 0%,rgba(245,240,230,.96) 100%);
      border-bottom:1px solid var(--line);
    }
    .drawer-title{font-size:2.1rem;line-height:1.02;}
    .drawer-close{width:44px;height:44px;}
    .drawer-body{
      padding:14px 16px 12px;
      flex:1;
      min-height:0;
      max-height:none;
      overflow:auto;
    }
    .selected-list{gap:10px;}
    .selected-group+.selected-group{margin-top:14px;padding-top:14px;}
    .drawer-foot{
      padding:14px 16px 18px;
      gap:10px;
      background:var(--paper);
      border-top:1px solid var(--line);
      max-height:42vh;
      overflow:auto;
    }
    .selector-name,.notes{padding:12px 12px;}
    .notes{min-height:86px;max-height:20vh;resize:none;}
    .export-output{max-height:120px;overflow:auto;font-size:.72rem;line-height:1.6;}
    .lb-bar{flex-direction:column;align-items:stretch;padding:12px 16px;gap:10px;}
    .lb-bar-actions{justify-content:stretch;}
    .lb-action{flex:1;justify-content:center;padding:10px 8px;font-size:.55rem;}
    .print-panel{max-height:94vh;}
    .print-cart-item{grid-template-columns:56px 1fr auto;}
    .print-cart-item img{width:56px;height:44px;}
  }
  @media(max-width:560px){
    .topbar{height:46px;padding:0 14px;gap:6px;}
    .top-actions{gap:6px;}
    .btn{padding:10px 14px;font-size:.6rem;}
    .topbar-home{width:32px;height:32px;}
    .hero{min-height:85vh;padding:48px 24px 44px;}
    .hero h1{font-size:clamp(2.4rem,12vw,3.6rem);}
    .hero-label{font-size:.48rem;letter-spacing:.36em;}
    .hero-monogram{height:30px;margin-bottom:28px;}
    .hero-meta{flex-direction:column;gap:10px;}
    .meta-dot{display:none;}
    .chapter-grid{grid-template-columns:1fr 1fr;}
    .chapter-card{padding:24px 14px 20px;}
    .chapter-card-name{font-size:.92rem;}
    .selection-steps{left:10px;right:10px;top:50%;}
    .selection-steps-action{flex-direction:column;}
    .drawer-title{font-size:1.8rem;}
    .drawer-body{max-height:none;}
    .drawer-foot{padding:12px 14px 16px;}
    .textarea-label{font-size:.54rem;letter-spacing:.2em;}
    .selected-item{grid-template-columns:66px 1fr auto;}
    .selected-item img{width:66px;height:54px;}
    .credit-text{font-size:.6rem;white-space:normal;text-align:center;}
    .section-jump{bottom:16px;right:16px;transform:scale(.8);transform-origin:bottom right;}
    .lb-action span{display:none;}
    .photo-card,.quote-card{border-radius:12px;}
    .photo-overlay{padding:8px;}
    .photo-id{font-size:.46rem;letter-spacing:.12em;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
    .photo-controls{display:none;}
  .photo-card.selected::after{top:8px;right:8px;padding:4px 7px;font-size:.42rem;letter-spacing:.12em;}
  .photo-card.not-selected::after{top:8px;right:8px;padding:4px 7px;font-size:.42rem;letter-spacing:.1em;}
    .photo-heart-btn{top:8px;right:8px;min-width:34px;height:34px;padding:0 9px;font-size:.95rem;}
  }

  @media(min-width:1500px){
    .photo-grid{max-width:1660px;}
  }

  /* ── Admin Mode ── */
  /* admin trigger moved to hamburger menu (.topbar-menu-admin) */
  .topbar-menu-admin{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border:1px solid var(--line);background:transparent;border-radius:4px;color:var(--mist);cursor:pointer;transition:all .25s;flex-shrink:0;margin:8px 18px 10px auto;}
  .topbar-menu-admin:hover{border-color:var(--teal);color:var(--teal);}
  .topbar-menu-admin.active{background:var(--teal);color:var(--ivory);border-color:var(--teal);}
  .admin-login-overlay{position:fixed;inset:0;z-index:500;background:rgba(15,14,12,.6);display:none;align-items:center;justify-content:center;padding:24px;backdrop-filter:blur(4px);}
  .admin-login-overlay.open{display:flex;}
  .admin-login-panel{width:min(400px,100%);padding:40px 36px;background:var(--paper);box-shadow:0 30px 80px rgba(0,0,0,.3);}
  .admin-login-panel h3{font-family:var(--serif);font-size:1.6rem;font-weight:300;margin-bottom:6px;}
  .admin-login-panel p{font-size:.82rem;color:var(--mist);margin-bottom:24px;line-height:1.6;}
  .admin-login-panel form{display:grid;grid-template-columns:1fr auto;gap:10px;}
  .admin-login-panel input{padding:13px 14px;border:1px solid var(--line);background:var(--ivory);color:var(--ink);}
  .admin-login-panel input:focus{outline:1px solid var(--teal);border-color:var(--teal);}
  .admin-login-error{display:none;margin-top:12px;color:#d44;font-size:.8rem;}
  .admin-login-error.visible{display:block;}

  .admin-bar{position:fixed;bottom:0;left:0;right:0;z-index:440;display:none;align-items:center;justify-content:space-between;gap:16px;padding:12px 24px;background:rgba(29,89,89,.95);backdrop-filter:blur(12px);color:var(--ivory);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;}
  .admin-bar.visible{display:flex;}
  .admin-bar-left{display:flex;align-items:center;gap:16px;}
  .admin-bar-badge{padding:5px 10px;background:rgba(244,237,224,.15);border-radius:2px;font-variant-numeric:tabular-nums;}
  .admin-bar-actions{display:flex;gap:8px;}
  .admin-bar-btn{padding:8px 14px;border:1px solid rgba(244,237,224,.3);background:transparent;color:var(--ivory);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;cursor:pointer;transition:background .2s;}
  .admin-bar-btn:hover{background:rgba(244,237,224,.12);}
  .admin-bar-btn.active{background:rgba(244,237,224,.2);border-color:rgba(244,237,224,.5);}

  /* ── Story Push button (admin only) ── */
  .story-push-btn{display:none;}
  .admin-mode .story-push-btn{display:grid;place-items:center;width:40px;height:40px;border:1px solid rgba(184,150,90,.5);background:rgba(26,24,20,.4);border-radius:50%;color:var(--gold-2);cursor:pointer;transition:all .25s;backdrop-filter:blur(4px);}
  .story-push-btn:hover{background:var(--gold);color:var(--teal-deep);border-color:var(--gold);}
  .story-push-btn.pushed{background:rgba(37,211,102,.7);border-color:rgba(37,211,102,.8);color:#fff;pointer-events:none;}

  /* ── Toast notification ── */
  .toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%) translateY(20px);z-index:600;padding:14px 28px;background:var(--ink);color:var(--ivory);font-size:.76rem;letter-spacing:.08em;border-radius:4px;box-shadow:0 8px 32px rgba(0,0,0,.3);opacity:0;transition:opacity .3s,transform .3s;pointer-events:none;white-space:nowrap;}
  .toast.visible{opacity:1;transform:translateX(-50%) translateY(0);}
  .toast.error{background:#c44;}
  .toast.success{background:rgba(29,89,89,.95);}

  .butterfly-layer{position:fixed;inset:0;z-index:980;pointer-events:none;overflow:hidden;contain:layout paint;isolation:isolate;transform:translateZ(0);}
  .butterfly{position:absolute;width:34px;height:26px;color:rgba(184,150,90,.82);opacity:0;will-change:transform,opacity;filter:drop-shadow(0 0 16px rgba(184,150,90,.2));mix-blend-mode:screen;}
  .butterfly svg{display:block;width:100%;height:100%;}
  .butterfly-wing{transform-box:fill-box;transform-origin:center center;animation:butterflyFlap .92s ease-in-out infinite;opacity:.92;}
  .butterfly-wing.left{transform-origin:100% 50%;}
  .butterfly-wing.right{transform-origin:0% 50%;animation-direction:reverse;}
  .butterfly-body{opacity:.72;}
  @keyframes butterflyDrift{
    0%{transform:translate3d(0,0,0) scale(var(--butterfly-scale,1)) rotate(var(--butterfly-tilt,0deg));opacity:0;}
    8%{opacity:.8;}
    85%{opacity:.45;}
    100%{transform:translate3d(var(--butterfly-drift-x,0px), calc(-1 * var(--butterfly-rise,120px)), 0) scale(var(--butterfly-scale,1)) rotate(calc(var(--butterfly-tilt,0deg) + var(--butterfly-spin,12deg)));opacity:0;}
  }
  @keyframes butterflyFlap{
    0%,100%{transform:scaleY(.96) rotate(0deg) translateX(0);}
    50%{transform:scaleY(1.08) rotate(4deg) translateX(1px);}
  }
  @media (prefers-reduced-motion: reduce){
    .butterfly{animation-duration:10s;opacity:.65;}
    .butterfly-wing{animation-duration:1.5s;}
  }

  .photo-card .admin-hide-toggle{position:absolute;top:8px;left:8px;z-index:10;width:32px;height:32px;border-radius:50%;border:1px solid rgba(244,237,224,.5);background:rgba(26,24,20,.5);backdrop-filter:blur(4px);color:var(--ivory);display:none;place-items:center;cursor:pointer;transition:background .2s,border-color .2s;font-size:.7rem;}
  .admin-mode .photo-card .admin-hide-toggle{display:grid;}
  .photo-card .admin-hide-toggle:hover{background:rgba(220,60,60,.7);border-color:rgba(220,60,60,.8);}
  .photo-card.admin-hidden{opacity:.4;position:relative;}
  .photo-card.admin-hidden::before{content:'HIDDEN';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:5;padding:6px 14px;background:rgba(220,60,60,.85);color:#fff;font-size:.55rem;letter-spacing:.2em;text-transform:uppercase;pointer-events:none;}
  .photo-card.admin-hidden .admin-hide-toggle{background:rgba(60,180,60,.5);border-color:rgba(60,180,60,.6);}
  .photo-card.admin-hidden .admin-hide-toggle:hover{background:rgba(60,180,60,.7);}

  @media(max-width:560px){
    .admin-bar{flex-wrap:wrap;gap:10px;padding:10px 16px;}
  }
</style>
</head>
<body class="{% if galleryPassword %}gallery-locked{% endif %}">
<div class="screen-lock" id="screenLock">
  <div class="lock-bg"></div>
  <div class="lock-overlay"></div>
  <div class="lock-panel">
    <img src="/assets/logo/logo-white.png" class="lock-logo" alt="Memorygraph"/>
    <div class="lock-label">A Memorygraph Gallery</div>
    <h1 class="lock-title">{{ couple_names or title }}</h1>
    <div class="lock-divider"></div>
    <p class="lock-copy">This is a private gallery. Enter the password shared with you to view, download, and shortlist photographs.</p>
    <form class="lock-form" id="lockForm">
      <input type="password" id="passwordInput" placeholder="Gallery password" autocomplete="current-password" required/>
      <button class="btn gold" type="submit">View Gallery</button>
    </form>
    <p class="lock-error" id="lockError">That password doesn't match. Please try again.</p>
  </div>
  <div class="lock-footer">
    <p class="lock-footer-text"><a href="/">Memorygraph Wedding Studio</a> &middot; Thrissur, Kerala</p>
  </div>
</div>

<!-- Admin trigger moved to hamburger menu -->

<div class="admin-login-overlay" id="adminLoginOverlay">
  <div class="admin-login-panel">
    <h3>Admin access</h3>
    <p>Enter admin password to manage gallery visibility.</p>
    <form id="adminLoginForm">
      <input type="password" id="adminPasswordInput" placeholder="Admin password" autocomplete="off" required/>
      <button class="btn" type="submit">Login</button>
    </form>
    <p class="admin-login-error" id="adminLoginError">Invalid admin password.</p>
  </div>
</div>

<div class="admin-bar" id="adminBar">
  <div class="admin-bar-left">
    <span>Admin Mode</span>
    <span class="admin-bar-badge"><span id="hiddenCount">0</span> hidden</span>
  </div>
  <div class="admin-bar-actions">
    <button class="admin-bar-btn" type="button" id="adminFilterHidden">Show Hidden Only</button>
    <button class="admin-bar-btn" type="button" id="adminLogout">Log Out</button>
  </div>
</div>

<main class="gallery-app" id="galleryApp" aria-hidden="true">

  <!-- ── Utility Bar (fixed, appears on scroll) ── -->
  <header class="topbar" id="topbar">
    <a href="/" aria-label="Memorygraph home"><img src="/assets/logo/logo-dark.png" alt="Memorygraph Wedding Studio"/></a>
    <div class="top-actions">
      <a href="/" class="btn ghost topbar-home" aria-label="Home">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </a>
      <button class="selection-pill" type="button" id="selectionPill">
        <svg class="selection-pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span id="selectionCount">0</span> selected
      </button>
      <button class="btn ghost" type="button" id="downloadAll">Download All</button>
      <button class="topbar-admin" type="button" id="topbarAdminTrigger" title="Admin settings" aria-label="Admin settings">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      </button>
      <button class="topbar-hamburger" type="button" id="topbarHamburger" aria-label="Menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
    <!-- Selection next-steps dropdown -->
    <div class="selection-steps" id="selectionSteps">
      <div class="selection-steps-head">
        <div class="selection-steps-title">Your album shortlist</div>
        <div class="selection-steps-sub">Here's how to get your selections to us:</div>
      </div>
      <div class="selection-steps-list">
        <div class="selection-step"><span class="selection-step-num">1</span><span>Browse the gallery and mark photos as selected or not selected</span></div>
        <div class="selection-step"><span class="selection-step-num">2</span><span>Open this panel to review your picks and add notes</span></div>
        <div class="selection-step"><span class="selection-step-num">3</span><span>Send your selection via WhatsApp or copy the list</span></div>
      </div>
      <div class="selection-steps-action">
        <button class="btn" type="button" id="stepsOpenDrawer">Share with Arun</button>
      </div>
    </div>
    <div class="selection-steps-backdrop" id="selectionStepsBackdrop" aria-hidden="true"></div>
    <div class="topbar-menu" id="topbarMenu">
      <a href="/" class="topbar-menu-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Home
      </a>
      <button class="topbar-menu-item" type="button" id="menuDownloadAll">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v12M7 10l5 5 5-5"/><path d="M5 20h14"/></svg>
        Download All Photos
      </button>
      <button class="topbar-menu-item" type="button" id="menuLockGallery">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="11" rx="1"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Lock Gallery
      </button>
      <button class="topbar-menu-admin" type="button" id="menuAdminTrigger" title="Admin mode" aria-label="Admin mode">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="11" rx="1"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1"/></svg>
      </button>
    </div>
  </header>

  <!-- ── Hero (full-bleed cinematic cover) ── -->
  <section class="hero" id="heroSection">
    {% if hero_video %}
    <video class="hero-video" autoplay muted loop playsinline poster="{{ hero_image or '' }}">
      <source src="{{ hero_video }}" type="video/mp4"/>
    </video>
    {% endif %}
    <div class="hero-bg" {% if hero_video %}style="display:none"{% endif %}></div>
    <div class="hero-overlay"></div>
    <div class="hero-copy">
      <img src="/assets/logo/logo-white.png" alt="Memorygraph" class="hero-monogram"/>
      {% if password %}
      <div class="hero-label">{{ hero_label or "Private Wedding Gallery" }}</div>
      {% endif %}
      <h1>{{ couple_names or title }}</h1>
      <p class="hero-sub">{{ intro }}</p>
      <div class="hero-meta">
        <div class="meta-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="2"/><circle cx="8.5" cy="8.5" r="2"/><path d="M21 15l-5-5L5 21"/></svg>
          <span class="meta-value" id="imageTotal">0</span> frames
        </div>
        {% if password %}
        <span class="meta-dot"></span>
        <div class="meta-item">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="11" rx="1"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Private gallery
        </div>
        {% endif %}
      </div>
    </div>
    <div class="hero-scroll-hint">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </div>
  </section>

  <!-- ── Authorship Line ── -->
  <div class="authorship">
    <p class="authorship-text">Photographed &amp; filmed by <a href="/">Memorygraph</a> &middot; Kerala</p>
    <span class="authorship-dot"></span>
    <a href="/" class="authorship-btn">
      Visit Memorygraphweddings.com
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>

  <!-- ── Chapter Index (section entry cards) ── -->
  {% if gallery_sections and gallery_sections.length %}
  <section class="chapter-index" id="chapterIndex">
    <div class="chapter-index-label">Chapters</div>
    <h2 class="chapter-index-title">{{ (chapter_heading or 'Your wedding <em>story,</em> in chapters.') | safe }}</h2>
    <p class="chapter-grid-hint">Select the chapter you want to jump to</p>
    <div class="chapter-grid" id="chapterGrid">
      {% for section in gallery_sections %}
      <div class="chapter-card" data-chapter-name="{{ section.name }}">
        <div class="chapter-card-num">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</div>
        <div class="chapter-card-name">{{ section.name }}</div>
        <div class="chapter-card-count" data-section-count="{{ section.name }}">—</div>
        <div class="chapter-card-rule"></div>
      </div>
      {% endfor %}
      <div class="chapter-card chapter-card--cta" id="chapterKnowMore">
        <div class="chapter-card-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
        </div>
        <div class="chapter-card-name">Know more about us</div>
        <div class="chapter-card-count">Memorygraph Weddings</div>
        <div class="chapter-card-rule"></div>
      </div>
    </div>
    <div class="chapter-index-cta">
      <p class="chapter-index-note">Scroll to explore, or jump to any chapter.</p>
      <button class="chapter-index-btn" type="button" id="scrollToGallery">
        Begin viewing
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </button>
    </div>
  </section>
  {% endif %}

  <section class="gallery-wrap" id="galleryWrap">
    {% if show_selection_section or show_selection_section == undefined %}
    <div class="selection-section">
      <div class="section-head">
        <div>
          <div class="eyebrow">Choose for album</div>
          <h2 class="section-title">{{ selection_title | safe }}</h2>
        </div>
        <p class="section-note">{{ selection_note }}</p>
      </div>
      <div class="print-banner" id="printBanner">
        <div class="print-banner-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="2" width="20" height="20" rx="1"/><rect x="5" y="5" width="14" height="14"/><path d="M2 2l3 3M22 2l-3 3M2 22l3-3M22 22l-3-3"/></svg>
