<script>
  // Auto-detect portrait hero → switch to split layout (desktop only)
  (function(){
    if(window.innerWidth < 981) return;
    var hero = document.querySelector('.hero');
    var bgEl = document.querySelector('.hero-bg');
    if(!hero || !bgEl) return;
    var bgUrl = getComputedStyle(bgEl).backgroundImage.replace(/url\(['"]?|['"]?\)/g, '');
    if(!bgUrl || bgUrl === 'none') return;
    var img = new Image();
    img.onload = function(){
      if(img.naturalHeight > img.naturalWidth) hero.classList.add('portrait-hero');
    };
    img.src = bgUrl;
  })();

  const galleryPassword = {{ password | json | safe }};
  const gallerySlug = {{ page.fileSlug | json | safe }};
  const galleryTitle = {{ title | json | safe }};
  const coupleNames = {{ (couple_names or title) | json | safe }};
  const whatsappNumber = {{ (whatsapp_number or "919846238073") | json | safe }};
  const showSelectButton = {% if show_select_button is defined %}{{ show_select_button | json | safe }}{% else %}true{% endif %};
  const showNotSelectedButton = {% if show_not_selected_button is defined %}{{ show_not_selected_button | json | safe }}{% else %}true{% endif %};
  const showOrderPrintButton = {% if show_order_print_button is defined %}{{ show_order_print_button | json | safe }}{% else %}true{% endif %};
  const gallerySections = {{ gallery_sections | json | safe }} || [];
  const galleryItems = {{ gallery_items | clientGalleryItems(gallery_folder, gallery_drive_images, gallery_sections) | json | safe }};
  const authKey = `memorygraph_gallery_unlocked_${gallerySlug}`;
  const storageKey = `memorygraph_album_selection_${gallerySlug}`;
  const notSelectedKey = `memorygraph_album_not_selected_${gallerySlug}`;
  const heartKey = `memorygraph_gallery_hearts_${gallerySlug}`;
  const notesKey = `memorygraph_album_notes_${gallerySlug}`;
  const selectorNameKey = `memorygraph_album_selector_${gallerySlug}`;
  let selected = new Set(JSON.parse(localStorage.getItem(storageKey) || '[]'));
  let notSelected = new Set(JSON.parse(localStorage.getItem(notSelectedKey) || '[]'));
  let hearted = new Set(JSON.parse(localStorage.getItem(heartKey) || '[]'));
  selected.forEach(id => notSelected.delete(id));
  let activeFilter = 'all';
  let sortMode = 'cms';
  let renderedImages = [];
  let lightboxIndex = 0;
  let likeCounts = {};

  const imageItems = galleryItems
    .map((item, index) => ({...item, order:index, item_type:item.item_type || (item.image ? 'image' : 'quote')}))
    .filter(item => item.item_type === 'image' && item.image)
    .map((item, index) => ({
      id: item.image_code || `MG-${String(index + 1).padStart(3, '0')}`,
      src: item.image,
      cat: (item.category || 'gallery').toLowerCase(),
      title: item.image_name || item.caption || `Image ${index + 1}`,
      caption: item.caption || '',
      order: item.order
    }));

  const screenLock = document.getElementById('screenLock');
  const galleryApp = document.getElementById('galleryApp');
  const photoGrid = document.getElementById('photoGrid');
  const selectionCount = document.getElementById('selectionCount');
  const selectedList = document.getElementById('selectedList');
  const albumDrawer = document.getElementById('albumDrawer');
  const selectorName = document.getElementById('selectorName');
  const albumNotes = document.getElementById('albumNotes');
  const exportOutput = document.getElementById('exportOutput');
  const whatsappSelection = document.getElementById('whatsappSelection');

  document.getElementById('imageTotal').textContent = imageItems.length;
  selectorName.value = localStorage.getItem(selectorNameKey) || '';
  albumNotes.value = localStorage.getItem(notesKey) || '';

  function unlockGallery(){
    screenLock.classList.add('hidden');
    galleryApp.setAttribute('aria-hidden','false');
    document.body.classList.remove('gallery-locked');
    sessionStorage.setItem(authKey,'true');
  }

  if(!galleryPassword || sessionStorage.getItem(authKey) === 'true') unlockGallery();

  document.getElementById('lockForm').addEventListener('submit', (event) => {
    event.preventDefault();
    const input = document.getElementById('passwordInput');
    const error = document.getElementById('lockError');
    if(input.value.trim() === String(galleryPassword || '').trim()){
      error.classList.remove('visible');
      unlockGallery();
    } else {
      error.classList.add('visible');
      input.select();
    }
  });

  // Lock-again handled by hamburger menu item #menuLockGallery

  function saveSelection(){
    localStorage.setItem(storageKey, JSON.stringify([...selected]));
  }

  function saveNotSelected(){
    localStorage.setItem(notSelectedKey, JSON.stringify([...notSelected]));
  }

  function sortedGalleryItems(){
    const normalized = galleryItems.map((item, index) => ({...item, order:index, item_type:item.item_type || (item.image ? 'image' : 'quote')}));
    if(sortMode === 'cms') return normalized;
    return [...normalized].sort((a, b) => {
      const aId = a.image_code || '';
      const bId = b.image_code || '';
      if(sortMode === 'selected') return Number(selected.has(bId)) - Number(selected.has(aId)) || a.order - b.order;
      if(sortMode === 'code') return aId.localeCompare(bId) || a.order - b.order;
      if(sortMode === 'name') return (a.image_name || a.caption || a.quote || '').localeCompare(b.image_name || b.caption || b.quote || '') || a.order - b.order;
      return a.order - b.order;
    });
  }

  function buildGallery(){
    const items = sortedGalleryItems();
    renderedImages = [];
    let visibleCount = 0;
    photoGrid.innerHTML = items.map((item) => {
      const type = item.item_type || (item.image ? 'image' : 'quote');
      if(type === 'section'){
        const slug = (item.section_name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        const hasCover = !!item.section_cover;
        const hasDesc = !!(item.section_description && item.section_description.trim());
        return `<div class="section-divider" data-type="section" data-section="${escapeAttr(slug)}" id="section-${escapeAttr(slug)}">
          <div class="section-divider-content">
            <span class="section-divider-rule"></span>
            <div class="section-divider-center">
              <span class="section-divider-name">${escapeHtml(item.section_name || '')}</span>
              ${hasDesc ? `<span class="section-divider-desc">${escapeHtml(item.section_description)}</span>` : ''}
            </div>
            <span class="section-divider-rule"></span>
          </div>
          <div class="section-divider-nav">
            <button type="button" data-dir="prev" aria-label="Previous section">prev</button>
            <span style="color:var(--line);opacity:.3;font-size:.6rem">|</span>
            <button type="button" data-dir="next" aria-label="Next section">next</button>
          </div>
        </div>`;
      }
      if(type === 'quote'){
        return `<article class="quote-card" data-type="quote" data-title="${escapeAttr(item.quote || '')}">
          <blockquote>${escapeHtml(item.quote || '')}</blockquote>
          ${item.quote_by ? `<cite>${escapeHtml(item.quote_by)}</cite>` : ''}
        </article>`;
      }
      const imageIndex = renderedImages.length;
      const id = item.image_code || `MG-${String(imageIndex + 1).padStart(3, '0')}`;
      const image = {
        id,
        src: item.image,
        cat: (item.category || 'gallery').toLowerCase(),
        title: item.image_name || item.caption || `Image ${imageIndex + 1}`,
        caption: item.caption || '',
        order: item.order
      };
      // Admin: skip hidden images for non-admin visitors
      const isHidden = hiddenImageIds.has(image.id);
      if(isHidden && !isAdminMode) return '';
      renderedImages.push(image);
      if(!isHidden) visibleCount++;
      const hiddenClass = isHidden ? ' admin-hidden' : '';
      const hideIcon = isHidden
        ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 1l22 22"/><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/></svg>'
        : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
      return `<article class="photo-card${selected.has(image.id) ? ' selected' : ''}${notSelected.has(image.id) ? ' not-selected' : ''}${hiddenClass}" data-type="image" data-id="${escapeAttr(image.id)}" data-cat="${escapeAttr(image.cat)}" data-title="${escapeAttr((image.title + ' ' + image.caption).toLowerCase())}">
        <button class="admin-hide-toggle" type="button" data-id="${escapeAttr(image.id)}" data-hidden="${isHidden ? '1' : '0'}" title="${isHidden ? 'Unhide' : 'Hide'} this image">${hideIcon}</button>
        <img src="${escapeAttr(image.src)}" alt="${escapeAttr(image.title)}" loading="lazy"/>
        <button class="photo-heart-btn${hearted.has(image.id) ? ' active' : ''}" type="button" data-id="${escapeAttr(image.id)}" aria-pressed="${hearted.has(image.id) ? 'true' : 'false'}" aria-label="${hearted.has(image.id) ? 'Remove heart for' : 'Leave a heart for'} ${escapeAttr(image.id)}">${heartMarkup(image.id)}</button>
        <div class="photo-overlay">
          <span class="photo-id">${escapeHtml(image.id)} · ${escapeHtml(image.title)}</span>
          <div class="photo-controls">
            <button class="icon-btn view-btn" type="button" data-index="${imageIndex}" aria-label="View ${escapeAttr(image.id)}">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
            <a class="icon-btn download-btn" href="${escapeAttr(image.src)}" download="${escapeAttr(fileNameForImage(image))}" aria-label="Download ${escapeAttr(image.id)}">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3v12M7 10l5 5 5-5"/><path d="M5 20h14"/></svg>
            </a>
            ${showSelectButton ? `<button class="icon-btn select-btn" type="button" data-id="${escapeAttr(image.id)}" aria-label="Select ${escapeAttr(image.id)}">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 6L9 17l-5-5"/></svg>
            </button>` : ''}
            ${showNotSelectedButton ? `<button class="icon-btn reject-btn" type="button" data-id="${escapeAttr(image.id)}" aria-label="Mark ${escapeAttr(image.id)} as not selected" title="Mark not selected">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>` : ''}
            ${showOrderPrintButton ? `<button class="icon-btn print-add-btn" type="button" data-index="${imageIndex}" aria-label="Order print of ${escapeAttr(image.id)}">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="1"/><rect x="5" y="5" width="14" height="14"/><path d="M2 2l3 3M22 2l-3 3M2 22l3-3M22 22l-3-3"/></svg>
            </button>` : ''}
            <button class="icon-btn story-push-btn" type="button" data-src="${escapeAttr(image.src)}" data-id="${escapeAttr(image.id)}" aria-label="Add to story" title="Add to story">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 5v14M5 12h14"/></svg>
            </button>
          </div>
        </div>
      </article>`;
    }).join('');
    // Update visible image count (exclude hidden for non-admin)
    if(!isAdminMode) document.getElementById('imageTotal').textContent = visibleCount;
    else document.getElementById('imageTotal').textContent = imageItems.length;
    photoGrid.querySelectorAll('.select-btn').forEach(button => button.addEventListener('click', (e) => { e.stopPropagation(); toggleSelect(button.dataset.id); }));
    photoGrid.querySelectorAll('.reject-btn').forEach(button => button.addEventListener('click', (e) => { e.stopPropagation(); toggleNotSelected(button.dataset.id); }));
    photoGrid.querySelectorAll('.photo-heart-btn').forEach(button => button.addEventListener('click', (e) => { e.stopPropagation(); toggleHeart(button.dataset.id); }));
    photoGrid.querySelectorAll('.view-btn').forEach(button => button.addEventListener('click', (e) => { e.stopPropagation(); openLightbox(Number(button.dataset.index)); }));
    photoGrid.querySelectorAll('.download-btn').forEach(link => link.addEventListener('click', (e) => {
      e.stopPropagation();
      e.preventDefault();
      downloadSingleImage(link.href, link.getAttribute('download') || 'image.jpg');
    }));
    photoGrid.querySelectorAll('.print-add-btn').forEach(button => button.addEventListener('click', (e) => { e.stopPropagation(); addToPrintCart(renderedImages[Number(button.dataset.index)]); }));
    photoGrid.querySelectorAll('.admin-hide-toggle').forEach(btn => btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if(!isAdminMode) return;
      const id = btn.dataset.id;
      const wasHidden = btn.dataset.hidden === '1';
      toggleImageVisibility(id, wasHidden ? 'unhide' : 'hide');
    }));
    photoGrid.querySelectorAll('.story-push-btn').forEach(btn => btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if(!isAdminMode) return;
      pushToStory(btn.dataset.src, btn.dataset.id, btn);
    }));
    photoGrid.querySelectorAll('.photo-card').forEach(card => {
      card.addEventListener('click', () => {
        const idx = renderedImages.findIndex(img => img.id === card.dataset.id);
        if (idx >= 0) openLightbox(idx);
      });
      card.style.cursor = 'pointer';
    });
    applyFilters(); // applyFilters calls layoutMasonry
    observeImageLoads();
    setupSectionObserver();
  }

  function getLikeCount(id){
    return Math.max(0, Number(likeCounts[id] || 0));
  }

  function heartMarkup(id){
    const count = getLikeCount(id);
    const active = hearted.has(id);
    const countMarkup = count > 0 ? ` <span class="photo-heart-count">${count}</span>` : "";
    return `${active ? '&#10084;&#65039;' : '&#129293;'}${countMarkup}`;
  }
  function toggleSelect(id){
    if(selected.has(id)) selected.delete(id);
    else {
      selected.add(id);
      notSelected.delete(id);
      saveNotSelected();
    }
    saveSelection();
    renderSelection();
    updatePhotoStatus(id);
    updateLightbox();
    if(sortMode === 'selected') buildGallery();
    else applyFilters();
  }

  function toggleNotSelected(id){
    if(notSelected.has(id)){
      notSelected.delete(id);
    }else{
      notSelected.add(id);
      selected.delete(id);
      saveSelection();
    }
    saveNotSelected();
    renderSelection();
    updatePhotoStatus(id);
    updateLightbox();
    if(sortMode === 'selected') buildGallery();
    else applyFilters();
  }

  function saveHearts(){
    localStorage.setItem(heartKey, JSON.stringify([...hearted]));
  }

  async function toggleHeart(id){
    const wasHearted = hearted.has(id);
    const previousCount = getLikeCount(id);
    if(wasHearted) hearted.delete(id);
    else hearted.add(id);
    likeCounts[id] = Math.max(0, previousCount + (wasHearted ? -1 : 1));
    saveHearts();
    updateHeartStatus(id);
    updateLightbox();
    try{
      const res = await fetch('/api/gallery-likes', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ slug: gallerySlug, imageId: id, action: wasHearted ? 'unlike' : 'like' })
      });
      if(!res.ok) throw new Error('Like update failed');
      const data = await res.json();
      if(data && data.likes){
        likeCounts = data.likes;
      }
      if(typeof data.count === 'number'){
        likeCounts[id] = data.count;
      }
      updateHeartStatus(id);
      updateLightbox();
    }catch(err){
      if(wasHearted) hearted.add(id);
      else hearted.delete(id);
      likeCounts[id] = previousCount;
      saveHearts();
      updateHeartStatus(id);
      updateLightbox();
    }
  }

  function updateHeartStatus(id){
    const isHearted = hearted.has(id);
    document.querySelectorAll(`.photo-card[data-id="${cssEscape(id)}"]`).forEach(card => {
      card.classList.toggle('hearted', isHearted);
      const btn = card.querySelector('.photo-heart-btn');
      if(btn){
        btn.classList.toggle('active', isHearted);
        btn.setAttribute('aria-pressed', isHearted ? 'true' : 'false');
        btn.innerHTML = heartMarkup(id);
        btn.setAttribute('aria-label', `${isHearted ? 'Remove heart for' : 'Leave a heart for'} ${id}`);
      }
    });
  }

  async function loadLikeCounts(){
    try{
      const res = await fetch(`/api/gallery-likes?slug=${encodeURIComponent(gallerySlug)}`);
      if(!res.ok) return;
      const data = await res.json();
      likeCounts = (data && data.likes && typeof data.likes === 'object') ? data.likes : {};
      renderedImages.forEach(image => updateHeartStatus(image.id));
      updateLightbox();
    }catch(err){
      // Keep local hearts working even if the shared counter endpoint is unavailable.
    }
  }

  function updatePhotoStatus(id){
    document.querySelectorAll(`.photo-card[data-id="${cssEscape(id)}"]`).forEach(card => {
      card.classList.toggle('selected', selected.has(id));
      card.classList.toggle('not-selected', notSelected.has(id));
    });
  }

  function imagesForIds(idSet){
    return imageItems.filter(image => idSet.has(image.id));
  }

  function renderSelection(){
    selectionCount.textContent = selected.size;
    const chosen = imagesForIds(selected);
    const rejected = imagesForIds(notSelected);
    const renderItem = (image, status) => `
      <div class="selected-item${status === 'not-selected' ? ' not-selected-pick' : ''}">
        <img src="${escapeAttr(image.src)}" alt="${escapeAttr(image.title)}"/>
        <div><strong>${escapeHtml(image.id)}</strong><span>${escapeHtml(status === 'not-selected' ? 'Not selected' : image.title)}</span></div>
        <button class="mini-remove" type="button" data-id="${escapeAttr(image.id)}" data-status="${escapeAttr(status)}" aria-label="Remove ${escapeAttr(image.id)}">x</button>
      </div>
    `;
    const groups = [];
    if(chosen.length){
      groups.push(`<div class="selected-group"><div class="selected-group-title">Selected images (${chosen.length})</div>${chosen.map(image => renderItem(image, 'selected')).join('')}</div>`);
    }
    if(rejected.length){
      groups.push(`<div class="selected-group"><div class="selected-group-title">Not selected images (${rejected.length})</div>${rejected.map(image => renderItem(image, 'not-selected')).join('')}</div>`);
    }
    selectedList.innerHTML = groups.length ? groups.join('') : '<p style="font-size:.88rem;line-height:1.8;color:var(--ink-soft);">No album picks marked yet. Choose the frames you want, or mark photos as not selected, then come back here to review them.</p>';
    selectedList.querySelectorAll('.mini-remove').forEach(button => button.addEventListener('click', () => {
      if(button.dataset.status === 'not-selected') toggleNotSelected(button.dataset.id);
      else toggleSelect(button.dataset.id);
    }));
    updateShareLinks();
  }

  function applyFilters(){
    const hideNonAll = activeFilter !== 'all';
    document.querySelectorAll('.photo-card,.quote-card,.section-divider').forEach((card) => {
      const type = card.dataset.type;
      if(type === 'section'){
        // Hide section dividers when not showing all photos
        card.classList.toggle('hidden', hideNonAll);
        return;
      }
      const matchesFilter = activeFilter === 'all' || (activeFilter === 'selected' && selected.has(card.dataset.id)) || card.dataset.cat === activeFilter || (activeFilter !== 'selected' && type === 'quote');
      card.classList.toggle('hidden', !matchesFilter);
    });
    layoutMasonry();
  }

  // ═══ MASONRY LAYOUT (virtual scroll + batched) ═══
  const DEFAULT_MASONRY_GAP = 20;
  const DEFAULT_ASPECT = 2/3; // portrait-friendly fallback before image ratios load
  const RENDER_BUFFER = 800;  // px above/below viewport to pre-render
  let masonryRAF = null;
  let cardAspects = {};  // cache image aspect ratios by src
  let masonryPositions = []; // precomputed {x, y, w, h} for each visible card index

  function getMasonryConfig(){
    const w = photoGrid.offsetWidth;
    if(w <= 560) return { cols: 2, gap: 14 };
    if(w <= 980) return { cols: 2, gap: 16 };
    if(window.innerWidth >= 1500) return { cols: 4, gap: DEFAULT_MASONRY_GAP };
    return { cols: 3, gap: DEFAULT_MASONRY_GAP };
  }

  function layoutMasonry(){
    if(masonryRAF) cancelAnimationFrame(masonryRAF);
    masonryRAF = requestAnimationFrame(_doMasonryLayout);
  }

  function _doMasonryLayout(){
    const cards = Array.from(photoGrid.children).filter(c => !c.classList.contains('hidden') && c.style.display !== 'none');
    if(!cards.length){ photoGrid.style.height = '0px'; return; }

    const masonryConfig = getMasonryConfig();
    const cols = masonryConfig.cols;
    const gap = masonryConfig.gap;
    const gridW = photoGrid.offsetWidth;
    const colW = (gridW - gap * (cols - 1)) / cols;
    const colHeights = new Array(cols).fill(0);
    const mobilePattern = [2, 1, 1, 1, 1, 2, 1, 1];
    let visualIndex = 0;
    let columnIndex = 0;

    // Phase 1: compute positions using cached aspect ratios (no DOM reads per card)
    masonryPositions = [];
    cards.forEach((card, i) => {
      const img = card.querySelector('img');
      const src = img ? img.getAttribute('src') : '';
      const isQuote = card.classList.contains('quote-card');
      const isSection = card.classList.contains('section-divider');

      let h, w, x, y;

      if(isSection){
        // Section dividers: full-width break — wait for all columns to align
        const maxH = Math.max(...colHeights);
        x = 0;
        y = maxH;
        w = gridW;
        const hasDesc = card.querySelector('.section-divider-desc');
        h = hasDesc ? 70 : 54;
        masonryPositions.push({ x, y, w, h });
        // Reset all columns — small gap after divider
        colHeights.fill(maxH + h + gap);
        visualIndex = 0;
        columnIndex = 0;
        return;
      }

      const fullSpan = !!(masonryConfig.mixed && (isQuote || mobilePattern[visualIndex % mobilePattern.length] === 2));
      let assignedCol = -1;
      if(fullSpan){
        const maxH = Math.max(...colHeights);
        x = 0;
        y = maxH;
        w = gridW;
      }else{
        // Shortest-column-first: place card in the column with least height
        let minH = colHeights[0];
        assignedCol = 0;
        for(let c = 1; c < cols; c++){
          if(colHeights[c] < minH){ minH = colHeights[c]; assignedCol = c; }
        }
        x = assignedCol * (colW + gap);
        y = colHeights[assignedCol];
        w = colW;
      }

      if(isQuote){
        h = cols === 1 ? 210 : 240;
      } else if(cardAspects[src]){
        h = w / cardAspects[src];
      } else if(img && img.naturalWidth > 0){
        const aspect = img.naturalWidth / img.naturalHeight;
        cardAspects[src] = aspect;
        h = w / aspect;
      } else {
        h = w / DEFAULT_ASPECT;
      }

      masonryPositions.push({ x, y, w, h });
      if(fullSpan){
        colHeights.fill(y + h + gap);
        columnIndex = 0;
      }else{
        colHeights[assignedCol] = y + h + gap;
        columnIndex++;
      }
      visualIndex++;
    });

    const totalH = Math.max(...colHeights);
    photoGrid.style.height = totalH + 'px';

    // Phase 2: batch write all positions + virtual scroll (show only near viewport)
    const scrollY = window.scrollY || window.pageYOffset;
    // Update cached position after layout changes
    updateCachedGridTop();
    const vpTop = scrollY - RENDER_BUFFER;
    const vpBottom = scrollY + window.innerHeight + RENDER_BUFFER;

    cards.forEach((card, i) => {
      const p = masonryPositions[i];
      const cardTop = cachedGridTop + p.y;
      const cardBottom = cardTop + p.h;
      const inView = cardBottom >= vpTop && cardTop <= vpBottom;

      card.style.position = 'absolute';
      card.style.width = p.w + 'px';
      card.style.height = p.h + 'px';
      card.style.left = p.x + 'px';
      card.style.top = p.y + 'px';
      card.style.visibility = inView ? 'visible' : 'hidden';
      card.style.contentVisibility = inView ? 'visible' : 'hidden';
    });
  }

  // Re-layout on scroll (for virtual scroll culling) + topbar visibility
  let scrollRAF = null;
  const topbarEl = document.getElementById('topbar');
  const heroSectionEl = document.getElementById('heroSection');
  const galleryWrapEl = document.getElementById('galleryWrap');
  window.addEventListener('scroll', () => {
    if(scrollRAF) return;
    scrollRAF = requestAnimationFrame(() => {
      scrollRAF = null;
      _applyVirtualScroll();
      maybeSpawnButterfly();
      // Show utility bar once hero scrolls out of view
      if(heroSectionEl && topbarEl){
        const heroBottom = heroSectionEl.getBoundingClientRect().bottom;
        const show = heroBottom <= 0;
        topbarEl.classList.toggle('visible', show);
        galleryApp.classList.toggle('bar-visible', show);
      }
    });
  }, {passive:true});

  let cachedGridTop = 0;
  function updateCachedGridTop(){
    cachedGridTop = photoGrid.getBoundingClientRect().top + (window.scrollY || window.pageYOffset);
  }

  function _applyVirtualScroll(){
    const cards = Array.from(photoGrid.children).filter(c => !c.classList.contains('hidden') && c.style.display !== 'none');
    if(!masonryPositions.length || cards.length !== masonryPositions.length) return;
    const scrollY = window.scrollY || window.pageYOffset;
    const vpTop = scrollY - RENDER_BUFFER;
    const vpBottom = scrollY + window.innerHeight + RENDER_BUFFER;
    cards.forEach((card, i) => {
      const p = masonryPositions[i];
      const cardTop = cachedGridTop + p.y;
      const cardBottom = cardTop + p.h;
      const inView = cardBottom >= vpTop && cardTop <= vpBottom;
      card.style.visibility = inView ? 'visible' : 'hidden';
      card.style.contentVisibility = inView ? 'visible' : 'hidden';
    });
  }

  // Re-layout on window resize (also update cached grid position)
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => { updateCachedGridTop(); layoutMasonry(); }, 150);
  });

  // Re-layout when images load (aspect ratio now known) — debounced to avoid thrashing
  let imgLoadTimer = null;
  function observeImageLoads(){
    photoGrid.querySelectorAll('img').forEach(img => {
      if(img.complete){
        if(img.naturalWidth > 0){
          cardAspects[img.getAttribute('src')] = img.naturalWidth / img.naturalHeight;
        }
        return;
      }
      img.addEventListener('load', function(){
        if(this.naturalWidth > 0){
          cardAspects[this.getAttribute('src')] = this.naturalWidth / this.naturalHeight;
        }
        // Debounce: batch relayouts from multiple simultaneous image loads
        clearTimeout(imgLoadTimer);
        imgLoadTimer = setTimeout(layoutMasonry, 80);
      }, {once:true});
      img.addEventListener('error', () => {
        clearTimeout(imgLoadTimer);
        imgLoadTimer = setTimeout(layoutMasonry, 80);
      }, {once:true});
    });
  }

  // ═══ SECTION NAVIGATION ═══
  const sectionJump = document.getElementById('sectionJump');
  const sectionSlugs = gallerySections ? gallerySections.map(s => (s.name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')) : [];
  let currentSectionIdx = -1;

  // Chapter index card clicks → scroll to that section in the grid
  document.querySelectorAll('.chapter-card').forEach(card => {
    card.addEventListener('click', () => {
      const name = card.dataset.chapterName || '';
      const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      if(slug) scrollToSection(slug);
    });
  });

  // "Know more about us" card → scroll to credits
  const knowMoreCard = document.getElementById('chapterKnowMore');
  if(knowMoreCard){
    knowMoreCard.addEventListener('click', () => {
      const credits = document.querySelector('.gallery-credit');
      if(credits) credits.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  // "Begin viewing" button → scroll to gallery wrap
  const scrollToGalleryBtn = document.getElementById('scrollToGallery');
  if(scrollToGalleryBtn){
    scrollToGalleryBtn.addEventListener('click', () => {
      const target = document.getElementById('galleryWrap');
      if(target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  // Populate chapter card frame counts
  function updateChapterCounts(){
    if(!gallerySections || !gallerySections.length) return;
    const items = galleryItems;
    gallerySections.forEach((sec, i) => {
      const startFile = sec.start_file || '';
      const startNoExt = startFile.replace(/\.[^.]+$/, '');
      // Find start index of this section
      let startIdx = items.findIndex(item => {
        if(item.item_type === 'section' && item.section_name === sec.name) return true;
        return false;
      });
      if(startIdx < 0) startIdx = 0;
      // Find start of next section
      let endIdx = items.length;
      if(i + 1 < gallerySections.length){
        const nextName = gallerySections[i+1].name;
        const nextIdx = items.findIndex((item, j) => j > startIdx && item.item_type === 'section' && item.section_name === nextName);
        if(nextIdx > 0) endIdx = nextIdx;
      }
      const count = items.slice(startIdx, endIdx).filter(item => (item.item_type || 'image') === 'image' && item.image).length;
      const el = document.querySelector(`[data-section-count="${sec.name}"]`);
      if(el) el.textContent = count + ' frames';
    });
  }
  updateChapterCounts();

  function scrollToSection(slug){
    const el = document.getElementById('section-' + slug);
    if(el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function jumpSection(dir){
    if(!sectionSlugs.length) return;
    let next = currentSectionIdx + dir;
    if(next < 0) next = 0;
    if(next >= sectionSlugs.length) next = sectionSlugs.length - 1;
    scrollToSection(sectionSlugs[next]);
  }

  // Floating prev/next buttons
  document.getElementById('sectionPrev').addEventListener('click', () => jumpSection(-1));
  document.getElementById('sectionNext').addEventListener('click', () => jumpSection(1));

  // Track active section on scroll
  let sectionObserver;
  function setupSectionObserver(){
    if(sectionObserver) sectionObserver.disconnect();
    const dividers = photoGrid.querySelectorAll('.section-divider');
    if(!dividers.length) return;

    // Show floating jump buttons once gallery has sections
    sectionJump.classList.add('visible');

    sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if(e.isIntersecting){
          const slug = e.target.dataset.section;
          currentSectionIdx = sectionSlugs.indexOf(slug);
        }
      });
    }, { rootMargin: '-30% 0px -60% 0px' });
    dividers.forEach(d => sectionObserver.observe(d));

    // Per-divider prev/next arrows
    dividers.forEach(d => {
      d.querySelectorAll('.section-divider-nav button').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const slug = d.dataset.section;
          const idx = sectionSlugs.indexOf(slug);
          const dir = btn.dataset.dir === 'prev' ? -1 : 1;
          const target = idx + dir;
          if(target >= 0 && target < sectionSlugs.length) scrollToSection(sectionSlugs[target]);
        });
      });
    });
  }


  function openAlbumDrawer(){
    closeSelectionSteps();
    if(topbarMenu) topbarMenu.classList.remove('open');
    albumDrawer.classList.add('open');
    document.body.style.overflow = 'hidden';
    updateShareLinks();
    renderSelection();
  }

  function closeAlbumDrawer(){
    albumDrawer.classList.remove('open');
    if(!lightbox.classList.contains('open')){
      document.body.style.overflow = '';
    }
  }

  const openDrawerBtn = document.getElementById('openDrawer');
  if(openDrawerBtn) openDrawerBtn.addEventListener('click', openAlbumDrawer);
  document.getElementById('closeDrawer').addEventListener('click', closeAlbumDrawer);
  selectorName.addEventListener('input', () => {
    localStorage.setItem(selectorNameKey, selectorName.value);
    updateShareLinks();
  });
  albumNotes.addEventListener('input', () => {
    localStorage.setItem(notesKey, albumNotes.value);
    updateShareLinks();
  });

  function selectionText(){
    const codes = imagesForIds(selected).map(image => image.id);
    const notSelectedCodes = imagesForIds(notSelected).map(image => image.id);
    const selectedBy = selectorName.value.trim();
    const notes = albumNotes.value.trim();
    return `Memorygraph album selection - ${coupleNames}\nGallery: ${galleryTitle}\nSelected by: ${selectedBy || 'Not provided'}\n\nSelected images (${codes.length}):\n${codes.length ? codes.join(', ') : 'None yet'}\n\nNot selected images (${notSelectedCodes.length}):\n${notSelectedCodes.length ? notSelectedCodes.join(', ') : 'None marked'}\n\nNotes:\n${notes || 'No notes added.'}`;
  }

  function requireSelectorName(){
    if(selectorName.value.trim()) return true;
    openAlbumDrawer();
    selectorName.focus();
    exportOutput.textContent = 'Please enter the name of the person selecting the album images before sending the selection.';
    exportOutput.classList.add('visible');
    return false;
  }

  function updateShareLinks(){
    const text = encodeURIComponent(selectionText());
    whatsappSelection.href = `https://wa.me/${whatsappNumber}?text=${text}`;
  }

  async function copyTextToClipboard(text){
    if(navigator.clipboard && navigator.clipboard.writeText){
      await navigator.clipboard.writeText(text);
      return true;
    }
    const helper = document.createElement('textarea');
    helper.value = text;
    helper.setAttribute('readonly', '');
    helper.style.position = 'fixed';
    helper.style.left = '-9999px';
