  lbStage.addEventListener('touchstart', event => {
    if(event.touches.length !== 1) return;
    const touch = event.touches[0];
    lightboxTouch = {
      id: touch.identifier,
      x: touch.clientX,
      y: touch.clientY,
      time: Date.now(),
    };
    lightboxSwipeHandled = false;
  }, {passive:true});
  lbStage.addEventListener('touchmove', event => {
    if(!lightboxTouch || event.touches.length !== 1) return;
    const touch = event.touches[0];
    if(touch.identifier !== lightboxTouch.id) return;
    const dx = touch.clientX - lightboxTouch.x;
    const dy = touch.clientY - lightboxTouch.y;
    if(Math.abs(dx) > 12 && Math.abs(dx) > Math.abs(dy)){
      lightboxSwipeHandled = true;
      event.preventDefault();
    }
  }, {passive:false});
  lbStage.addEventListener('touchend', event => {
    if(!lightboxTouch) return;
    const touch = Array.from(event.changedTouches).find(t => t.identifier === lightboxTouch.id);
    if(!touch) return;
    const dx = touch.clientX - lightboxTouch.x;
    const dy = touch.clientY - lightboxTouch.y;
    const dt = Date.now() - lightboxTouch.time;
    if(Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy) && dt < 700){
      lightboxSwipeHandled = true;
      if(dx < 0){
        document.getElementById('lbNext').click();
      } else {
        document.getElementById('lbPrev').click();
      }
    }
    lightboxTouch = null;
    setTimeout(() => { lightboxSwipeHandled = false; }, 300);
  }, {passive:true});
  lbStage.addEventListener('touchcancel', () => {
    lightboxTouch = null;
    lightboxSwipeHandled = false;
  }, {passive:true});
  lightbox.querySelector('.lb-stage').addEventListener('click', event => {
    if(lightboxSwipeHandled) return;
    if(event.target === event.currentTarget || event.target === lbImage) closeLightbox();
