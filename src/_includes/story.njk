<script src="https://cdn.jsdelivr.net/npm/gsap@3.12/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12/dist/ScrollTrigger.min.js" defer></script>
<script src="/assets/js/main.js" defer></script>

<script>
  // Floating nav: show after scrolling past hero
  (function(){
    var fp = document.getElementById('floatPrev');
    var fn = document.getElementById('floatNext');
    if(!fp && !fn) return;
    var hero = document.querySelector('.story-hero');
    if(!hero) return;
    var shown = false;
    window.addEventListener('scroll', function(){
      var past = hero.getBoundingClientRect().bottom < 0;
      if(past && !shown){ shown = true; if(fp) fp.classList.add('visible'); if(fn) fn.classList.add('visible'); }
      if(!past && shown){ shown = false; if(fp) fp.classList.remove('visible'); if(fn) fn.classList.remove('visible'); }
    }, {passive:true});
  })();

  // Portrait hero auto-detect
  (function(){
    if(window.innerWidth < 981) return;
    var hero = document.querySelector('.story-hero');
    var bgEl = document.querySelector('.story-hero-img');
    if(!hero || !bgEl) return;
    var bgUrl = bgEl.style.backgroundImage.replace(/url\(['"]?|['"]?\)/g, '');
    if(!bgUrl) return;
    var img = new Image();
    img.onload = function(){ if(img.naturalHeight > img.naturalWidth) hero.classList.add('portrait-hero'); };
    img.src = bgUrl;
  })();

  // Legacy reveal fallback
  if(!window.gsap){
    var obs = new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){x.target.classList.add('visible');obs.unobserve(x.target);}});},{threshold:.1});
    document.querySelectorAll('.reveal,.gsap-reveal').forEach(function(r){obs.observe(r);});
  }
</script>
</body>
</html>
