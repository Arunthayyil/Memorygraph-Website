<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta name="author" content="Memorygraph Wedding Studio"/>
<meta name="robots" content="index, follow"/>
<title>{{ title }} — A Wedding in {{ location_short }} | Memorygraph</title>
<meta name="description" content="A cinematic wedding story of {{ title }} at {{ location }}. Photographed and filmed by Memorygraph Wedding Studio."/>
<meta name="keywords" content="Wedding Photographer {{ location_short }}, Kerala Wedding, {{ title }} Wedding Story, Memorygraph"/>
<meta property="og:title" content="{{ title }} — A {{ location_short }} Wedding Story"/>
<meta property="og:description" content="A cinematic wedding story of {{ title }} at {{ location }}. Photographed and filmed by Memorygraph Wedding Studio."/>
<meta property="og:type" content="article"/>
<meta property="og:url" content="https://memorygraphweddings.com{{ page.url }}"/>
<meta property="og:image" content="{{ 'https://memorygraphweddings.com' + hero }}"/>
<meta property="og:locale" content="en_IN"/>
<meta property="og:site_name" content="Memorygraph Weddings"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content="{{ title }} — A {{ location_short }} Wedding Story"/>
<meta name="twitter:description" content="A cinematic wedding story of {{ title }} at {{ location }}."/>
<meta name="twitter:image" content="{{ 'https://memorygraphweddings.com' + hero }}"/>
<link rel="canonical" href="https://memorygraphweddings.com{{ page.url }}"/>
<link rel="icon" href="/assets/logo/favicon-32.png" type="image/png" sizes="32x32"/>
<link rel="apple-touch-icon" href="/assets/logo/favicon-180.png"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" onload="this.onload=null;this.rel='stylesheet'"/>
<noscript><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet"/></noscript>
<link rel="stylesheet" href="/assets/css/global.css"/>
<link rel="stylesheet" href="/assets/css/animations.css"/>
<style>
  /* ═══ STORY HERO ═══ */
  .story-hero{position:relative;width:100%;height:100vh;min-height:700px;overflow:hidden;}
  .story-hero-img{position:absolute;inset:0;background-size:cover;background-position:center;background-color:#c9bda1;}
  .story-hero-img.placeholder{background:linear-gradient(160deg,#d8cfb8 0%,#b8a98a 50%,#a89a78 100%);}
  .story-hero-overlay{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(26,24,20,.35) 0%,rgba(26,24,20,.08) 25%,rgba(26,24,20,.15) 50%,rgba(26,24,20,.6) 80%,rgba(26,24,20,.88) 100%);}
  .story-hero-content{position:absolute;bottom:0;left:0;right:0;padding:0 56px 80px;color:var(--ivory);z-index:2;}
  .story-hero-eyebrow{font-family:var(--sans);font-size:.6rem;font-weight:400;letter-spacing:.38em;text-transform:uppercase;color:var(--gold-2);margin-bottom:24px;display:flex;align-items:center;gap:14px;opacity:0;animation:fadeUp .8s .3s forwards;}
  .story-hero-eyebrow::before{content:'';width:32px;height:1px;background:var(--gold-2);}
  .story-hero-name{font-family:var(--serif);font-size:clamp(3.8rem,9vw,9rem);font-weight:300;line-height:.92;letter-spacing:-.02em;margin-bottom:28px;opacity:0;animation:fadeUp .9s .5s forwards;}
  .story-hero-name em{font-style:italic;color:var(--gold-2);}
  .story-hero-meta{display:flex;gap:32px;flex-wrap:wrap;font-family:var(--sans);font-size:.68rem;letter-spacing:.22em;text-transform:uppercase;color:rgba(244,237,224,.75);opacity:0;animation:fadeUp .9s .7s forwards;}
  .story-hero-meta-item{display:flex;align-items:center;gap:10px;}
  .story-hero-meta-item::before{content:'';width:16px;height:1px;background:var(--gold-2);opacity:.5;}
  .story-hero-meta-item:first-child::before{display:none;}

  .story-gallery-link{display:inline-flex;align-items:center;gap:10px;margin-top:28px;padding:13px 26px;background:rgba(244,237,224,.08);border:1px solid rgba(244,237,224,.2);backdrop-filter:blur(8px);color:var(--ivory);font-family:var(--sans);font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;text-decoration:none;transition:all .3s;opacity:0;animation:fadeUp .9s .9s forwards;}
  .story-gallery-link:hover{background:rgba(244,237,224,.15);border-color:var(--gold-2);color:var(--gold-2);}
  .story-gallery-link svg{flex-shrink:0;}
  .story-gallery-link-note{display:block;margin-top:2px;font-size:.5rem;letter-spacing:.16em;color:rgba(244,237,224,.4);text-transform:uppercase;}

  .story-hero-scroll{position:absolute;bottom:32px;right:56px;z-index:2;color:var(--ivory);opacity:0;animation:fadeIn 1s 1.2s forwards;}
  .story-hero-scroll-line{width:1px;height:48px;background:rgba(244,237,224,.3);position:relative;overflow:hidden;margin:0 auto;}
  .story-hero-scroll-line::after{content:'';position:absolute;top:-100%;left:0;width:100%;height:100%;background:var(--gold-2);animation:scrollAnim 2s ease-in-out 1.5s infinite;}
  @keyframes scrollAnim{0%{top:-100%;}100%{top:100%;}}

  /* ═══ PORTRAIT HERO — split layout (desktop) ═══ */
  @media(min-width:981px){
    .story-hero.portrait-hero{display:grid;grid-template-columns:1fr 1fr;height:100vh;min-height:700px;}
    .story-hero.portrait-hero .story-hero-img{position:relative;inset:auto;grid-column:2;grid-row:1/3;background-position:center top;}
    .story-hero.portrait-hero .story-hero-overlay{position:relative;inset:auto;grid-column:1;grid-row:1/3;background:var(--ink);}
    .story-hero.portrait-hero .story-hero-content{position:absolute;bottom:auto;left:0;right:auto;width:50%;top:50%;transform:translateY(-50%);padding:0 56px;z-index:2;}
    .story-hero.portrait-hero .story-hero-name{font-size:clamp(3rem,5vw,6rem);}
    .story-hero.portrait-hero .story-hero-scroll{grid-column:1;right:auto;left:56px;}
  }

  /* ═══ FLOATING STORY NAV (prev/next) ═══ */
  .float-nav{position:fixed;top:50%;z-index:90;transform:translateY(-50%);opacity:0;transition:opacity .4s,transform .4s;pointer-events:none;}
  .float-nav.visible{opacity:1;pointer-events:auto;}
  .float-nav-btn{display:flex;align-items:center;gap:0;text-decoration:none;color:var(--ink-soft);transition:all .3s;background:rgba(244,237,224,.85);backdrop-filter:blur(12px);border:1px solid var(--line-2);overflow:hidden;padding:14px;border-radius:50%;box-shadow:0 4px 20px rgba(26,24,20,.08);}
  .float-nav-btn:hover{background:var(--ivory);border-color:var(--teal);color:var(--teal);box-shadow:0 8px 32px rgba(26,24,20,.12);}
  .float-nav-btn svg{flex-shrink:0;}
  .float-nav-label{max-width:0;overflow:hidden;white-space:nowrap;transition:max-width .35s cubic-bezier(.22,1,.36,1),padding .35s;padding:0;font-family:var(--sans);font-size:.54rem;letter-spacing:.16em;text-transform:uppercase;}
  .float-nav-btn:hover .float-nav-label{max-width:160px;padding:0 10px 0 6px;}
  .float-nav--prev{left:20px;}
  .float-nav--next{right:20px;}
  .float-nav--prev .float-nav-btn:hover .float-nav-label{padding:0 6px 0 10px;}

  /* ═══ INTRO QUOTE ═══ */
  .story-intro{padding:120px 56px;text-align:center;max-width:920px;margin:0 auto;}
  .story-intro-label{font-family:var(--sans);font-size:.6rem;letter-spacing:.35em;text-transform:uppercase;color:var(--teal);margin-bottom:28px;}
  .story-intro-quote{font-family:var(--serif);font-size:clamp(1.6rem,3.2vw,2.6rem);font-weight:300;font-style:italic;line-height:1.5;color:var(--ink);margin-bottom:32px;}
  .story-intro-quote::before,.story-intro-quote::after{content:'\201C';color:var(--gold);font-size:2.6rem;line-height:0;vertical-align:-.1em;}
  .story-intro-quote::after{content:'\201D';}
  .story-intro-author{font-family:var(--sans);font-size:.62rem;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);display:inline-flex;align-items:center;gap:14px;}
  .story-intro-author::before,.story-intro-author::after{content:'';width:28px;height:1px;background:var(--gold);}

  /* ═══ NARRATIVE ═══ */
  .story-narrative{max-width:720px;margin:0 auto;padding:0 24px 120px;}
  .narrative-eyebrow{font-family:var(--sans);font-size:.6rem;letter-spacing:.35em;text-transform:uppercase;color:var(--teal);margin-bottom:22px;display:flex;align-items:center;gap:14px;}
  .narrative-eyebrow::before{content:'';width:28px;height:1px;background:var(--teal);}
  .narrative-title{font-family:var(--serif);font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:300;line-height:1.15;color:var(--ink);margin-bottom:36px;}
  .narrative-title em{font-style:italic;color:var(--teal);}
  .narrative-body p{font-family:var(--sans);font-size:.95rem;font-weight:300;line-height:2.1;color:var(--ink-soft);margin-bottom:22px;}
  .narrative-body p:first-of-type::first-letter{font-family:var(--serif);font-size:3.6rem;font-weight:400;float:left;line-height:.85;padding:6px 10px 0 0;color:var(--teal);}

  /* ═══ FILM ═══ */
  .story-film{background:var(--ink);padding:100px 56px;text-align:center;}
  .film-eyebrow{font-family:var(--sans);font-size:.6rem;letter-spacing:.35em;text-transform:uppercase;color:var(--gold);margin-bottom:22px;}
  .film-title{font-family:var(--serif);font-size:clamp(2rem,3.5vw,3rem);font-weight:300;line-height:1.15;color:var(--ivory);margin-bottom:48px;}
  .film-title em{font-style:italic;color:var(--gold-2);}
  .film-frame{max-width:1100px;margin:0 auto;aspect-ratio:16/9;background:#0a0907;border:1px solid rgba(184,150,90,.15);position:relative;overflow:hidden;}
  .film-frame iframe{width:100%;height:100%;border:0;}
  .film-frame.placeholder{display:flex;align-items:center;justify-content:center;color:var(--mist);font-family:var(--serif);font-style:italic;}

  /* ═══ GALLERY ═══ */
  .story-gallery{padding:120px 0 48px;}
  .gallery-eyebrow-wrap{text-align:center;margin-bottom:64px;padding:0 56px;}
  .gallery-eyebrow{font-family:var(--sans);font-size:.6rem;letter-spacing:.35em;text-transform:uppercase;color:var(--teal);margin-bottom:20px;}
  .gallery-title{font-family:var(--serif);font-size:clamp(2.2rem,3.8vw,3.6rem);font-weight:300;line-height:1.1;color:var(--ink);}
  .gallery-title em{font-style:italic;color:var(--teal);}
  .gallery-masonry{columns:3;column-gap:4px;padding:0 4px;}
  .gal-item{break-inside:avoid;margin-bottom:4px;overflow:hidden;cursor:pointer;position:relative;background:#ece4d4;line-height:0;}
  .gal-item img{width:100%;height:auto;display:block;transition:transform .8s cubic-bezier(.22,1,.36,1);}
  .gal-item:hover img{transform:scale(1.02);}
  .gallery-quote{text-align:center;padding:80px 48px;max-width:840px;margin:0 auto;}
  .gallery-quote-text{font-family:var(--serif);font-size:clamp(1.4rem,2.6vw,2.2rem);font-weight:300;font-style:italic;line-height:1.55;color:var(--ink);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:48px 0;}
  .gallery-quote-text em{color:var(--teal);}

  /* ═══ STATS ═══ */
  .story-stats{background:var(--ivory-2);padding:72px 56px;border-top:1px solid var(--line-2);border-bottom:1px solid var(--line-2);}
  .stats-grid{display:grid;grid-template-columns:repeat(4,1fr);max-width:1000px;margin:0 auto;gap:32px;}
  .stat-box{text-align:center;padding:0 16px;}
  .stat-box strong{display:block;font-family:var(--serif);font-size:clamp(2.2rem,3.5vw,3.2rem);font-weight:300;color:var(--teal);line-height:1;margin-bottom:10px;}
  .stat-box span{font-family:var(--sans);font-size:.58rem;letter-spacing:.24em;text-transform:uppercase;color:var(--mist);}

  /* ═══ ALBUM SPREADS ═══ */
  .story-album{padding:80px 56px;background:var(--ink);}
  .story-album-header{text-align:center;margin-bottom:44px;}
  .story-album-label{font-family:var(--sans);font-size:.6rem;letter-spacing:.35em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;}
  .story-album-sub{font-family:var(--sans);font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(244,237,224,.3);}
  .story-album-spreads{display:flex;flex-direction:column;gap:3px;margin-bottom:36px;}
  .story-album-spread img{width:100%;aspect-ratio:8/3;object-fit:cover;display:block;transition:transform .8s ease;}
  .story-album-spread:hover img{transform:scale(1.015);}
  .story-album-cta{text-align:center;}
  .story-album-link{font-family:var(--sans);font-size:.64rem;letter-spacing:.26em;text-transform:uppercase;color:var(--gold);text-decoration:none;border-bottom:1px solid rgba(184,150,90,.3);padding-bottom:4px;transition:border-color .3s;}
  .story-album-link:hover{border-color:var(--gold);}

  /* ═══ INLINE CTA ═══ */
  .story-inline-cta{text-align:center;padding:72px 56px;border-top:1px solid var(--line-2);border-bottom:1px solid var(--line-2);}
  .story-inline-cta-text{font-family:var(--serif);font-size:clamp(1.5rem,2.8vw,2rem);font-weight:300;font-style:italic;color:var(--ink);margin-bottom:24px;}
  .story-inline-cta-note{display:block;margin-top:18px;font-family:var(--sans);font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--mist);}

  /* ═══ JOURNAL ═══ */
  .story-journal{padding:72px 56px;}
  .story-journal-eyebrow{font-family:var(--sans);font-size:.6rem;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);margin-bottom:12px;}
  .story-journal-title{font-family:var(--serif);font-size:1.4rem;font-weight:300;font-style:italic;color:var(--ink);margin-bottom:32px;}
  .story-journal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .story-journal-card{text-decoration:none;color:inherit;}
  .story-journal-card-img{position:relative;padding-bottom:62%;overflow:hidden;background:linear-gradient(160deg,#d8cfb8,#a89a78);margin-bottom:12px;}
  .story-journal-card-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.22,1,.36,1);}
  .story-journal-card:hover .story-journal-card-img img{transform:scale(1.04);}
  .story-journal-card h3{font-family:var(--serif);font-size:1.1rem;font-weight:400;line-height:1.3;margin-bottom:5px;}
  .story-journal-card .sj-meta{font-family:var(--sans);font-size:.56rem;letter-spacing:.18em;text-transform:uppercase;color:var(--mist);}

  /* ═══ BOTTOM STORY NAV ═══ */
  .story-nav{background:var(--ink);display:grid;grid-template-columns:1fr 1fr;border-top:1px solid rgba(244,237,224,.06);}
  .story-nav-card{padding:28px 40px;display:flex;flex-direction:column;gap:6px;text-decoration:none;color:var(--ivory);transition:background .25s;position:relative;}
  .story-nav-card:first-child{border-right:1px solid rgba(244,237,224,.06);}
  .story-nav-card:hover{background:rgba(244,237,224,.03);}
  .story-nav-direction{font-family:var(--sans);font-size:.54rem;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);display:flex;align-items:center;gap:8px;}
  .story-nav-card.next .story-nav-direction{justify-content:flex-end;}
  .story-nav-couple{font-family:var(--serif);font-size:1.15rem;font-weight:300;color:rgba(244,237,224,.85);transition:color .3s;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .story-nav-card:hover .story-nav-couple{color:var(--gold-2);}
  .story-nav-card.next{text-align:right;}
  .story-nav-meta{font-family:var(--sans);font-size:.56rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(244,237,224,.25);}

  /* ═══ CTA ═══ */
  .story-cta{padding:120px 56px;text-align:center;background:linear-gradient(160deg,var(--teal-deep),var(--teal) 100%);color:var(--ivory);position:relative;overflow:hidden;}
  .story-cta::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%,rgba(184,150,90,.08),transparent 60%);}
  .story-cta-eyebrow{font-family:var(--sans);font-size:.6rem;letter-spacing:.35em;text-transform:uppercase;color:var(--gold-2);margin-bottom:22px;position:relative;z-index:1;}
  .story-cta-title{font-family:var(--serif);font-size:clamp(2.2rem,4vw,3.6rem);font-weight:300;line-height:1.1;margin-bottom:18px;position:relative;z-index:1;}
  .story-cta-title em{font-style:italic;color:var(--gold-2);}
  .story-cta-sub{font-family:var(--sans);font-size:.88rem;color:rgba(244,237,224,.65);margin-bottom:36px;position:relative;z-index:1;}
  .btn-gold{font-family:var(--sans);font-size:.68rem;letter-spacing:.25em;text-transform:uppercase;background:var(--gold);color:var(--teal-deep);padding:15px 40px;text-decoration:none;transition:all .35s;display:inline-block;border:1px solid var(--gold);position:relative;z-index:1;}
  .btn-gold:hover{background:var(--gold-2);}

  /* ═══ ANIMATIONS ═══ */
  @keyframes fadeUp{from{opacity:0;transform:translateY(24px);}to{opacity:1;transform:translateY(0);}}
  @keyframes fadeIn{from{opacity:0;}to{opacity:1;}}

  /* ═══ RESPONSIVE ═══ */
  @media(max-width:980px){
    .story-hero-content{padding:0 24px 56px;}
    .story-hero-scroll{display:none;}
    .story-intro,.story-narrative,.story-film,.story-cta{padding-left:24px;padding-right:24px;}
    .story-intro{padding-top:56px;padding-bottom:56px;}
    .story-narrative{padding-bottom:64px;}
    .story-film{padding-top:56px;padding-bottom:56px;}
    .story-gallery{padding-top:56px;padding-bottom:24px;}
    .gallery-quote{padding:48px 24px;}
    .gallery-eyebrow-wrap{padding:0 24px;}
    .gallery-masonry{columns:2;column-gap:3px;padding:0 3px;}
    .gal-item{margin-bottom:3px;}
    .stats-grid{grid-template-columns:1fr 1fr;gap:24px;}
    .story-stats{padding:56px 24px;}
    .story-journal{padding:56px 24px;}
    .story-journal-grid{grid-template-columns:1fr;}
    .story-inline-cta{padding:56px 24px;}
    .story-nav{grid-template-columns:1fr;}
    .story-nav-card{padding:16px 20px;}
    .story-nav-card:first-child{border-right:none;border-bottom:1px solid rgba(244,237,224,.06);}
    .story-nav-card.next{text-align:left;}
    .story-nav-card.next .story-nav-direction{justify-content:flex-start;}
    .story-album{padding:56px 24px;}
    .story-album-spread img{aspect-ratio:16/9;}
    .float-nav{display:none;}
    .story-cta{padding:72px 24px;}
  }
  @media(max-width:600px){
    .gallery-masonry{columns:1;}
    .story-hero-meta{gap:16px;}
    .story-hero-meta-item::before{display:none;}
  }
  @media(max-width:767.98px){
    .story-gallery{background:var(--ivory);padding-top:64px;padding-bottom:34px;}
    .gallery-eyebrow-wrap{margin-bottom:34px;padding:0 20px;}
    .gallery-masonry{display:block;columns:2;column-gap:14px;padding:0 18px;}
    .gal-item{break-inside:avoid;margin:0 0 14px;border-radius:12px;background:#ede5d6;box-shadow:0 10px 30px rgba(26,24,20,.07);}
    .gal-item img{width:100%;height:auto;object-fit:contain;display:block;}
    .gal-item:hover img{transform:none;}
    .gallery-quote{break-inside:avoid;column-span:all;padding:36px 4px;margin:0 0 14px;}
  }
</style>
</head>
<body>

<!-- PRELOADER -->
<div class="preloader" id="preloader">
  <div class="preloader-logo">Memorygraph<small>Photographing Memories</small></div>
  <div class="preloader-line"></div>
</div>

<div class="page-transition-overlay"></div>

<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox">
  <button class="lightbox-close" aria-label="Close lightbox"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
  <button class="lightbox-nav lightbox-prev" aria-label="Previous image"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 18l-6-6 6-6"/></svg></button>
  <img class="lightbox-img" src="" alt="Gallery image"/>
  <button class="lightbox-nav lightbox-next" aria-label="Next image"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18l6-6-6-6"/></svg></button>
  <div class="lightbox-caption"></div>
</div>

<!-- NAV -->
<nav id="nav">
  <a href="/" class="nav-logo">
    <img src="/assets/logo/logo-dark.png" alt="Memorygraph Wedding Studio" style="height:48px;width:auto;max-width:160px;display:block;"/>
  </a>
  <ul class="nav-links">
    <li><a href="/">Home</a></li>
    <li><a href="/stories/" class="active">Stories</a></li>
    <li><a href="/about/">About</a></li>
    <li><a href="/investment/">Investment</a></li>
    <li><a href="/blog/">Journal</a></li>
  </ul>
  <a href="/contact/" class="nav-cta">Begin Your Story</a>
  <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
</nav>

<!-- MOBILE MENU -->
<div class="mobile-menu" id="mobileMenu">
  <ul>
    <li><a href="/">Home</a></li>
    <li><a href="/stories/">Stories</a></li>
    <li><a href="/about/">About</a></li>
    <li><a href="/investment/">Investment</a></li>
    <li><a href="/blog/">Journal</a></li>
    <li><a href="/contact/">Contact</a></li>
  </ul>
  <a href="/contact/" class="mobile-menu-cta">Begin Your Story</a>
</div>

<!-- ═══ FLOATING PREV / NEXT ═══ -->
{%- set prevStory = collections.stories | getPreviousCollectionItem -%}
{%- set nextStory = collections.stories | getNextCollectionItem -%}
{% if prevStory %}
<div class="float-nav float-nav--prev" id="floatPrev">
  <a href="{{ prevStory.url }}" class="float-nav-btn" aria-label="Previous story: {{ prevStory.data.title }}">
    <span class="float-nav-label">{{ prevStory.data.title }}</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 18l-6-6 6-6"/></svg>
  </a>
</div>
{% endif %}
{% if nextStory %}
<div class="float-nav float-nav--next" id="floatNext">
  <a href="{{ nextStory.url }}" class="float-nav-btn" aria-label="Next story: {{ nextStory.data.title }}">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18l6-6-6-6"/></svg>
    <span class="float-nav-label">{{ nextStory.data.title }}</span>
  </a>
</div>
{% endif %}

<!-- ═══ STORY HERO ═══ -->
{%- set matchedGallery = null -%}
{%- for g in collections.clientGalleries -%}
  {%- if g.fileSlug == page.fileSlug or g.data.title == title -%}
    {%- set matchedGallery = g -%}
  {%- endif -%}
{%- endfor -%}
<section class="story-hero">
  <div class="story-hero-img {% if not hero %}placeholder{% endif %}" style="background-image: url('{{ hero }}');"></div>
  <div class="story-hero-overlay"></div>
  <div class="story-hero-content">
    <div class="story-hero-eyebrow">A Wedding Story</div>
    <h1 class="story-hero-name">{{ title }}</h1>
    <div class="story-hero-meta">
      <div class="story-hero-meta-item">{{ location }}</div>
      <div class="story-hero-meta-item">{{ date | formatDate }}</div>
      <div class="story-hero-meta-item">By Memorygraph</div>
    </div>
    {% if matchedGallery %}
    <a href="{{ matchedGallery.url }}" class="story-gallery-link">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
      <span>
        View Client Gallery
        <span class="story-gallery-link-note">Password protected</span>
      </span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
    {% endif %}
  </div>
  <div class="story-hero-scroll">
    <div class="story-hero-scroll-line"></div>
  </div>
</section>

<!-- ═══ INTRO QUOTE ═══ -->
<section class="story-intro gsap-reveal">
  <div class="story-intro-label">In Their Own Words</div>
  <blockquote class="story-intro-quote">{{ quote }}</blockquote>
  <div class="story-intro-author">{{ quote_by if quote_by else title }}</div>
</section>

<!-- ═══ NARRATIVE ═══ -->
<article class="story-narrative">
  <div class="narrative-eyebrow gsap-reveal">The Story</div>
  <h2 class="narrative-title gsap-reveal reveal-d1 stagger-words">{{ chapter_title | safe if chapter_title else title }}</h2>
  <div class="narrative-body gsap-reveal reveal-d2">
    {{ content | safe }}
  </div>
</article>

<!-- ═══ FILM ═══ -->
{% if film_url %}
<section class="story-film">
  <div class="film-eyebrow gsap-reveal">Watch the Film</div>
  <h2 class="film-title gsap-reveal reveal-d1 stagger-words">A short film of <em>their day</em>.</h2>
  <div class="film-frame gsap-reveal reveal-d2">
    <iframe src="{{ film_url }}" title="Wedding film of {{ title }}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
  </div>
</section>
{% endif %}

<!-- ═══ GALLERY ═══ -->
<section class="story-gallery">
  <div class="gallery-eyebrow-wrap">
    <div class="gallery-eyebrow gsap-reveal">The Photographs</div>
    <h2 class="gallery-title gsap-reveal reveal-d1 stagger-words">Frames from <em>the day</em>.</h2>
  </div>
  {%- set allImages = gallery | storyGalleryImages(gallery_folder) -%}
  <div class="gallery-masonry">
    {% for img in allImages %}
      {% if img.type == "quote" %}
        <div class="gallery-quote gsap-reveal">
          <blockquote class="gallery-quote-text">{{ img.text }}</blockquote>
        </div>
      {% else %}
        <div class="gal-item">
          <img src="{{ img.src }}" alt="{{ title }}" loading="lazy" data-lightbox="{{ img.src }}" data-caption="{{ title }}"/>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<!-- ═══ INLINE CTA ═══ -->
<div class="story-inline-cta gsap-reveal">
  <p class="story-inline-cta-text">Love what you see?</p>
  <a href="/contact/" class="btn-gold magnetic">Begin Your Story</a>
  <span class="story-inline-cta-note">A few season dates still open &middot; Kerala &amp; destination</span>
</div>

{% if album_spreads and album_spreads.length > 0 %}
<!-- ═══ HEIRLOOM ALBUM ═══ -->
<section class="story-album">
  <div class="story-album-header">
    <div class="story-album-label">The Heirloom Album</div>
    <p class="story-album-sub">32 &times; 12" &middot; Lay-flat &middot; Archival print</p>
  </div>
  <div class="story-album-spreads">
    {% for spread in album_spreads %}
    <div class="story-album-spread">
      <img src="{{ spread.image if spread.image else spread }}" alt="Album spread from {{ title }}" loading="lazy"/>
    </div>
    {% endfor %}
  </div>
  <div class="story-album-cta">
    <a href="/investment/#album" class="story-album-link">Add an album to your package &rarr;</a>
  </div>
</section>
{% endif %}

<!-- ═══ STATS ═══ -->
<section class="story-stats gsap-reveal">
  <div class="stats-grid">
    <div class="stat-box"><strong>{{ stat_images if stat_images else "&mdash;" }}</strong><span>Images Delivered</span></div>
    <div class="stat-box"><strong>{{ stat_hours if stat_hours else "&mdash;" }}</strong><span>Hours of Coverage</span></div>
    <div class="stat-box"><strong>{{ stat_photographers if stat_photographers else "2" }}</strong><span>Photographers</span></div>
    <div class="stat-box"><strong>{{ date | formatDate }}</strong><span>Wedding Day</span></div>
  </div>
</section>

<!-- ═══ JOURNAL ═══ -->
{% if collections.blog and collections.blog.length > 0 %}
<section class="story-journal gsap-reveal">
  <div class="story-journal-eyebrow">From the Journal</div>
  <h2 class="story-journal-title">Planning tips &amp; wedding-day wisdom</h2>
  <div class="story-journal-grid">
    {% for post in collections.blog %}
      {% if loop.index <= 3 %}
      <a href="{{ post.url }}" class="story-journal-card">
        <div class="story-journal-card-img"><img src="{{ post.data.hero or site.defaultSocialImage }}" alt="{{ post.data.imageAlt or post.data.title }}" loading="lazy"/></div>
        <h3>{{ post.data.title }}</h3>
        <div class="sj-meta">{{ post.data.category }} · {{ post.templateContent | readingTime }} min read</div>
      </a>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

<!-- ═══ PREV / NEXT (bottom) ═══ -->
<nav class="story-nav">
  {% if prevStory %}
  <a href="{{ prevStory.url }}" class="story-nav-card prev">
    <div class="story-nav-direction">
      <svg width="14" height="10" viewBox="0 0 14 10" fill="none"><path d="M5 1L1 5l4 4M13 5H1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
      Previous Story
    </div>
    <div class="story-nav-couple">{{ prevStory.data.title }}</div>
    <div class="story-nav-meta">{{ prevStory.data.location_short }} &middot; {{ prevStory.date | formatDate }}</div>
  </a>
  {% else %}
  <a href="/stories/" class="story-nav-card prev">
    <div class="story-nav-direction">
      <svg width="14" height="10" viewBox="0 0 14 10" fill="none"><path d="M5 1L1 5l4 4M13 5H1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
      All Stories
    </div>
    <div class="story-nav-couple">View all stories</div>
  </a>
  {% endif %}
  {% if nextStory %}
  <a href="{{ nextStory.url }}" class="story-nav-card next">
    <div class="story-nav-direction">
      Next Story
      <svg width="14" height="10" viewBox="0 0 14 10" fill="none"><path d="M9 1l4 4-4 4M1 5h12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
    </div>
    <div class="story-nav-couple">{{ nextStory.data.title }}</div>
    <div class="story-nav-meta">{{ nextStory.data.location_short }} &middot; {{ nextStory.date | formatDate }}</div>
  </a>
  {% else %}
  <a href="/stories/" class="story-nav-card next">
    <div class="story-nav-direction">
      All Stories
      <svg width="14" height="10" viewBox="0 0 14 10" fill="none"><path d="M9 1l4 4-4 4M1 5h12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
    </div>
    <div class="story-nav-couple">View all stories</div>
  </a>
  {% endif %}
</nav>

<!-- ═══ CTA ═══ -->
<section class="story-cta">
  <div class="story-cta-eyebrow gsap-reveal">Could yours be next?</div>
  <h2 class="story-cta-title gsap-reveal reveal-d1 stagger-words">Let's tell <em>your</em><br>story, beautifully.</h2>
  <p class="story-cta-sub gsap-reveal reveal-d2">A few openings remaining for the season. Kerala &amp; destination weddings welcome.</p>
  <a href="/contact/" class="btn-gold gsap-reveal magnetic">Begin Your Story</a>
</section>

