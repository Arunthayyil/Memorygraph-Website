<!-- UNDER CONSTRUCTION NOTICE -->
<div class="wip-overlay" id="wipOverlay" style="display:none;">
  <div class="wip-panel">
    <button class="wip-close" id="wipClose" type="button" aria-label="Close">&times;</button>
    <div class="wip-icon">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
    </div>
    <h3 class="wip-title">We're still setting up</h3>
    <p class="wip-body">This website is under construction and not fully updated yet. Feel free to browse around to get a feel of our work &mdash; all pages and links are functional, including <a href="/contact/">Contact</a>.</p>
    <button class="wip-btn" id="wipDismiss" type="button">Got it, continue</button>
  </div>
</div>
<style>
  .wip-overlay{position:fixed;inset:0;z-index:9999;background:rgba(15,14,12,.45);display:flex;align-items:center;justify-content:center;padding:24px;backdrop-filter:blur(3px);animation:wipFadeIn .3s ease;}
  @keyframes wipFadeIn{from{opacity:0}to{opacity:1}}
  .wip-panel{width:min(440px,100%);padding:40px 36px 32px;background:var(--paper,#fbf7ef);border:1px solid rgba(29,89,89,.12);box-shadow:0 24px 64px rgba(26,24,20,.18);text-align:center;position:relative;}
  .wip-close{position:absolute;top:14px;right:14px;width:32px;height:32px;border:1px solid rgba(26,24,20,.12);background:transparent;color:rgba(26,24,20,.4);font-size:1.1rem;border-radius:50%;cursor:pointer;display:grid;place-items:center;transition:color .2s,border-color .2s;}
  .wip-close:hover{color:rgba(26,24,20,.8);border-color:rgba(26,24,20,.3);}
  .wip-icon{margin-bottom:18px;color:rgba(184,150,90,.7);}
  .wip-title{font-family:var(--serif,Georgia,serif);font-size:1.4rem;font-weight:300;margin-bottom:12px;color:var(--ink,#1a1814);}
  .wip-body{font-size:.86rem;line-height:1.8;color:rgba(26,24,20,.6);margin-bottom:28px;}
  .wip-body a{color:var(--teal,#1d5959);text-decoration:underline;text-underline-offset:2px;}
  .wip-btn{padding:13px 32px;border:0;background:var(--teal,#1d5959);color:#fff;font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;transition:background .25s;}
  .wip-btn:hover{background:var(--teal-deep,#174a4a);}
</style>
<script>
(function(){
  if(sessionStorage.getItem('mg_wip_seen')) return;
  var overlay = document.getElementById('wipOverlay');
  if(!overlay) return;
  // Show after preloader finishes (delay 2s to let preloader clear)
  setTimeout(function(){ overlay.style.display = 'flex'; }, 2000);
  function close(){
    overlay.style.display = 'none';
    sessionStorage.setItem('mg_wip_seen','1');
  }
  document.getElementById('wipClose').addEventListener('click', close);
  document.getElementById('wipDismiss').addEventListener('click', close);
  overlay.addEventListener('click', function(e){ if(e.target === overlay) close(); });
})();
</script>
